@model List<WebDocTruyen.Models.Truyen>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thử nghiệm";
}

<div class="search-page-container">
    <!-- Header hiển thị tab & từ khóa -->
    <div class="search-top-header">
        <div class="search-tabs">
            <span class="tab-item active">Truyện</span>
            <span class="tab-item">Hồ sơ</span>
        </div>
        <h1 class="search-keyword">"@ViewBag.TuKhoa"</h1>
        <div class="search-count-label">@(Model?.Count() ?? 0) kết quả</div>
    </div>

    <!-- DANH SÁCH TRUYỆN TOÀN KHUNG (FULL-WIDTH) -->
    <main class="search-main-content">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-search-box">
                <i class="fas fa-search"></i>
                <h3>Không tìm thấy kết quả</h3>
                <p>Không có truyện nào phù hợp với từ khóa <strong>"@ViewBag.TuKhoa"</strong>.</p>
            </div>
        }
        else
        {
            <div class="wattpad-story-list">
                @foreach (var item in Model)
                {
                    <div class="wattpad-item-card">
                        <!-- Ảnh bìa -->
                        <a href="/Truyen/Details/@item.MaTruyen" class="wp-cover-wrap">
                            <img src="@item.AnhBia" alt="@item.TenTruyen" class="wp-cover-img" loading="lazy" />
                        </a>

                        <!-- Nội dung chi tiết -->
                        <div class="wp-info-wrap">
                            <!-- Tiêu đề truyện -->
                            <h3 class="wp-title">
                                <a href="/Truyen/Details/@item.MaTruyen">@item.TenTruyen</a>
                            </h3>

                            <!-- Hàng Badges: Hoàn thành & Trưởng thành -->
                            <div class="wp-badges-wrap">
                                <span class="wp-badge-complete">@item.TrangThai</span>
                                <span class="wp-badge-mature">Trưởng thành</span>
                            </div>

                            <!-- 3 Cột: Lượt đọc | Lượt bình chọn (Lượt thích) | Chương -->
                            <div class="wp-stats-row">
                                <!-- Cột 1: Lượt đọc -->
                                <div class="wp-stat-col">
                                    <div class="wp-stat-top">
                                        <svg class="wp-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                        </svg>
                                        <span>Lượt xem</span>
                                    </div>
                                    <div class="wp-stat-value">@item.LuotXem</div>
                                </div>

                                <div class="wp-stat-divider"></div>

                                <!-- Cột 2: Lượt bình chọn (LuotThich) -->
                                <div class="wp-stat-col">
                                    <div class="wp-stat-top">
                                        <svg class="wp-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                        </svg>
                                        <span>Lượt thích</span>
                                    </div>
                                    <div class="wp-stat-value">@item.LuotThich</div>
                                </div>

                                <div class="wp-stat-divider"></div>

                                <!-- Cột 3: Chương -->
                                <div class="wp-stat-col">
                                    <div class="wp-stat-top">
                                        <svg class="wp-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                            <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                                        </svg>
                                        <span>Chính sách</span>
                                    </div>
                                    <div class="wp-stat-value">@item.ChinhSachTruyCap</div>
                                </div>
                            </div>

                            <!-- Đoạn văn án tóm tắt -->
                            <p class="wp-description">
                                @item.MoTa
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>
@section styles {
<style>
    .search-page-container {
        max-width: 980px;
        margin: 25px auto 60px auto;
        padding: 0 15px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* Tabs & Header */
    .search-top-header {
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 14px;
        margin-bottom: 24px;
    }
    .search-tabs {
        display: flex;
        gap: 24px;
        margin-bottom: 10px;
    }
    .tab-item {
        font-size: 20px;
        color: #6b7280;
        cursor: pointer;
        padding-bottom: 6px;
        font-weight: 500;
    }
    .tab-item.active {
        font-weight: 800;
        color: #111827;
        border-bottom: 3px solid #ff5722;
    }
    .search-keyword {
        font-size: 26px;
        font-weight: 800;
        color: #111827;
        margin: 0 0 4px 0;
    }
    .search-count-label {
        font-size: 13px;
        color: #6b7280;
    }

    /* Danh sách kết quả */
    .search-main-content {
        width: 100%;
    }
    .wattpad-story-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Card truyện */
    .wattpad-item-card {
        background: #ffffff;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        gap: 24px;
        align-items: flex-start;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .wattpad-item-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    }

    /* Khung ảnh bìa */
    .wp-cover-wrap {
        width: 135px;
        height: 195px;
        flex-shrink: 0;
        border-radius: 8px;
        overflow: hidden;
        display: block;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
        background: #f8fafc;
    }
    .wp-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Cột nội dung bên phải */
    .wp-info-wrap {
        flex: 1;
        min-width: 0;
    }

    /* Tiêu đề truyện */
    .wp-title {
        margin: 0 0 12px 0;
        font-size: 20px;
        font-weight: 800;
        line-height: 1.3;
    }
    .wp-title a {
        color: #111827;
        text-decoration: none;
    }
    .wp-title a:hover {
        color: #ff5722;
    }

    /* Hàng Badges */
    .wp-badges-wrap {
        display: flex;
        gap: 8px;
        margin-bottom: 14px;
    }
    .wp-badge-complete {
        background-color: #196f5b;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 20px;
        display: inline-block;
    }
    .wp-badge-mature {
        background-color: #831843;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 20px;
        display: inline-block;
    }

    /* 3 Cột Thông số có vạch chia */
    .wp-stats-row {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
    }
    .wp-stat-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .wp-stat-top {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        color: #6b7280;
        margin-bottom: 2px;
    }
    .wp-icon {
        color: #6b7280;
    }
    .wp-stat-value {
        font-size: 15px;
        font-weight: 800;
        color: #111827;
    }
    .wp-stat-divider {
        width: 1px;
        height: 28px;
        background-color: #e5e7eb;
    }

    /* Đoạn tóm tắt văn án */
    .wp-description {
        font-size: 13.5px;
        line-height: 1.55;
        color: #374151;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Box trống */
    .empty-search-box {
        text-align: center;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 50px 20px;
        color: #6b7280;
    }
    .empty-search-box i {
        font-size: 38px;
        color: #d1d5db;
        margin-bottom: 12px;
    }

</style>
}