@model WebDocTruyen.Models.TheLoai

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa Thể Loại";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-600 mx-auto">
    <h3 class="mb-3 text-danger"><i class="fas fa-exclamation-triangle me-2"></i> Xác Nhận Xóa Thể Loại</h3>
    <p class="text-muted">Bạn có chắc chắn muốn xóa thể loại <strong>@Model.TenTheLoai</strong> này không?</p>

    <form asp-area="Admin" asp-controller="TheLoaiManagement" asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaTheLoai" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i> Xác Nhận Xóa</button>
            <a href="/Admin/TheLoaiManagement/Index" class="btn btn-secondary">Hủy Bỏ</a>
        </div>
    </form>
</div>