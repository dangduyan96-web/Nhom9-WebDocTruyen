@model WebDocTruyen.Models.TheLoai

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh Sửa Thể Loại";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-warning"><i class="fas fa-edit me-2"></i> Chỉnh Sửa Thể Loại</h3>

    <form asp-area="Admin" asp-controller="TheLoaiManagement" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="MaTheLoai" />

        <div class="mb-3">
            <label asp-for="TenTheLoai" class="form-label fw-bold">Tên Thể Loại</label>
            <input asp-for="TenTheLoai" class="form-control" />
            <span asp-validation-for="TenTheLoai" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Slug" class="form-label fw-bold">Slug</label>
            <input asp-for="Slug" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="MoTa" class="form-label fw-bold">Mô Tả</label>
            <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-white"><i class="fas fa-save me-1"></i> Cập Nhật</button>
            <a href="/Admin/TheLoaiManagement/Index" class="btn btn-secondary">Quay Lại</a>
        </div>
    </form>
</div>