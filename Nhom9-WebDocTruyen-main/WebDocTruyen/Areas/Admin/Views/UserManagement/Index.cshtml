@model IEnumerable<WebDocTruyen.Models.NguoiDung>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản Lý Tài Khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👥 Quản Lý Tài Khoản Người Dùng</h2>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Họ Tên</th>
                    <th>Email</th>
                    <th>Vai Trò</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaNguoiDung</td>
                        <td class="fw-bold">@item.TenDangNhap</td>
                        <td>@(string.IsNullOrEmpty(item.HoTen) ? "Chưa cập nhật" : item.HoTen)</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.MaVaiTro == 1 ? "bg-danger" : "bg-info text-dark")">
                                @(item.MaVaiTroNavigation?.TenVaiTro ?? "Thành viên")
                            </span>
                        </td>
                        <td>
                            @if (item.IsKhoa == true)
                            {
                                <span class="badge bg-secondary">Đã khóa</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/Admin/UserManagement/ToggleLock/@item.MaNguoiDung"
                               class="btn btn-sm @(item.IsKhoa == true ? "btn-outline-success" : "btn-outline-secondary")"
                               onclick="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái tài khoản này không?');">
                                <i class="fas @(item.IsKhoa == true ? "fa-unlock" : "fa-lock")"></i>
                                @(item.IsKhoa == true ? "Mở Khóa" : "Khóa")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>