@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Trang Tổng Quan Admin";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Bảng Điều Khiển Quản Trị</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Tổng quan hệ thống Web Đọc Truyện</li>
    </ol>

    <!-- Các thẻ thống kê nhanh -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-primary text-white shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Quản lý Truyện</div>
                            <div class="h5 mb-0 font-weight-bold">Xem & Thêm sửa xóa</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-book fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-transparent border-0">
                    <a class="text-white stretched-link text-decoration-none" href="/Admin/TruyenManagement">Chi tiết</a>
                    <i class="fas fa-angle-right text-white"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-success text-white shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Thể Loại</div>
                            <div class="h5 mb-0 font-weight-bold">Danh mục truyện</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-transparent border-0">
                    <a class="text-white stretched-link text-decoration-none" href="#">Chi tiết</a>
                    <i class="fas fa-angle-right text-white"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-warning text-white shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Tài Khoản</div>
                            <div class="h5 mb-0 font-weight-bold">Thành viên / Admin</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-transparent border-0">
                    <a class="text-white stretched-link text-decoration-none" href="#">Chi tiết</a>
                    <i class="fas fa-angle-right text-white"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-danger text-white shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col me-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Thống Kê</div>
                            <div class="h5 mb-0 font-weight-bold">Lượt xem & Doanh thu</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-bar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between small bg-transparent border-0">
                    <a class="text-white stretched-link text-decoration-none" href="#">Chi tiết</a>
                    <i class="fas fa-angle-right text-white"></i>
                </div>
            </div>
        </div>
    </div>
</div>