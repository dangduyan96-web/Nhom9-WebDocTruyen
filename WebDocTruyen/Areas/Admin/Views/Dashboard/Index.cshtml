@model WebDocTruyen.Areas.Admin.ViewModels.DashboardViewModel

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Trang Tổng Quan & Thống Kê";
}

<style>
    /* Premium Modern Dashboard UI */
    .kpi-card-modern {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #edf2f7;
        padding: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px -2px rgba(16, 24, 40, 0.05);
    }

    .kpi-card-modern:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -4px rgba(16, 24, 40, 0.1);
        border-color: #e2e8f0;
    }

    .kpi-card-modern::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }

    .kpi-card-modern.card-truyen::before { background: linear-gradient(90deg, #3b82f6, #60a5fa); }
    .kpi-card-modern.card-user::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .kpi-card-modern.card-views::before { background: linear-gradient(90deg, #06b6d4, #38bdf8); }
    .kpi-card-modern.card-revenue::before { background: linear-gradient(90deg, #10b981, #34d399); }

    .kpi-icon-wrapper {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        transition: all 0.3s ease;
    }

    .card-truyen .kpi-icon-wrapper { background: #eff6ff; color: #2563eb; }
    .card-user .kpi-icon-wrapper { background: #fffbeb; color: #d97706; }
    .card-views .kpi-icon-wrapper { background: #ecfeff; color: #0891b2; }
    .card-revenue .kpi-icon-wrapper { background: #ecfdf5; color: #059669; }

    .kpi-card-modern:hover .kpi-icon-wrapper {
        transform: scale(1.1) rotate(5deg);
    }

    .kpi-label {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #64748b;
        margin-bottom: 6px;
    }

    .kpi-number {
        font-size: 30px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        margin-bottom: 4px;
        letter-spacing: -0.5px;
    }

    .kpi-subtext {
        font-size: 13px;
        color: #94a3b8;
    }

    .kpi-link {
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px dashed #f1f5f9;
        width: 100%;
        transition: gap 0.2s ease;
    }

    .card-truyen .kpi-link { color: #2563eb; }
    .card-user .kpi-link { color: #d97706; }
    .card-views .kpi-link { color: #0891b2; }
    .card-revenue .kpi-link { color: #059669; }

    .kpi-link:hover {
        gap: 10px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-extrabold text-dark mb-1" style="font-weight: 800;">📊 Bảng Điều Khiển Quản Trị</h2>
        <p class="text-muted mb-0 small">Hệ thống theo dõi thời gian thực dữ liệu truyện, lượt đọc và doanh thu</p>
    </div>
    <div>
        <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-xs">
            <i class="far fa-calendar-alt text-primary me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>
</div>

<!-- 4 THẺ CHỈ SỐ KPI ĐƯỢC THIẾT KẾ LẠI THEO CHUẨN HIỆN ĐẠI -->
<div class="row g-4 mb-4">
    <!-- Thẻ 1: Tổng số truyện -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card-modern card-truyen">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Tổng Số Truyện</div>
                    <div class="kpi-number">@Model.TongSoTruyen.ToString("N0")</div>
                    <div class="kpi-subtext">Bộ truyện trên hệ thống</div>
                </div>
                <div class="kpi-icon-wrapper shadow-xs">
                    <i class="fas fa-book"></i>
                </div>
            </div>
            <a href="/Admin/TruyenManagement" class="kpi-link">
                <span>Quản lý danh sách</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- Thẻ 2: Độc giả & Thành viên -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card-modern card-user">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Độc Giả & Thành Viên</div>
                    <div class="kpi-number">@Model.TongSoNguoiDung.ToString("N0")</div>
                    <div class="kpi-subtext">Tài khoản đã đăng ký</div>
                </div>
                <div class="kpi-icon-wrapper shadow-xs">
                    <i class="fas fa-user-friends"></i>
                </div>
            </div>
            <a href="/Admin/UserManagement" class="kpi-link">
                <span>Quản lý tài khoản</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- Thẻ 3: Tổng lượt xem -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card-modern card-views">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Tổng Lượt Xem</div>
                    <div class="kpi-number">@Model.TongLuotXem.ToString("N0")</div>
                    <div class="kpi-subtext">Lượt đọc truyện tích lũy</div>
                </div>
                <div class="kpi-icon-wrapper shadow-xs">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
            <a href="#sectionLuotXem" class="kpi-link">
                <span>Xem bảng xếp hạng</span>
                <i class="fas fa-arrow-down"></i>
            </a>
        </div>
    </div>

    <!-- Thẻ 4: Tổng doanh thu -->
    <div class="col-xl-3 col-md-6">
        <div class="kpi-card-modern card-revenue">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Tổng Doanh Thu</div>
                    <div class="kpi-number text-success">@Model.TongDoanhThu.ToString("N0") <span style="font-size: 18px;">đ</span></div>
                    <div class="kpi-subtext">VNPAY & PayPal</div>
                </div>
                <div class="kpi-icon-wrapper shadow-xs">
                    <i class="fas fa-sack-dollar"></i>
                </div>
            </div>
            <a href="#sectionDoanhThu" class="kpi-link">
                <span>Chi tiết doanh thu</span>
                <i class="fas fa-arrow-down"></i>
            </a>
        </div>
    </div>
</div>

<!-- CHI TIẾT TỪNG PHẦN DOANH THU & LƯỢT XEM -->
<div class="row g-4 mb-4" id="sectionDoanhThu">
    <!-- Phân tích Doanh Thu -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 h-100 bg-white">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="fas fa-coins text-warning me-2"></i>Nguồn Doanh Thu Thanh Toán
                </h5>
                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold">VNPAY & PayPal</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-4 border">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-danger rounded-circle p-2"><i class="fas fa-book-open text-white"></i></span>
                                <span class="fw-semibold text-muted small">Mua lẻ truyện (US08)</span>
                            </div>
                            <h4 class="fw-bold text-danger mb-0">@Model.DoanhThuMuaTruyen.ToString("N0") đ</h4>
                            <small class="text-muted">@Model.SoDonMuaTruyen đơn thành công</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-4 border">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-warning rounded-circle p-2"><i class="fas fa-crown text-dark"></i></span>
                                <span class="fw-semibold text-muted small">Gói đọc VIP (US07)</span>
                            </div>
                            <h4 class="fw-bold text-success mb-0">@Model.DoanhThuGoiDoc.ToString("N0") đ</h4>
                            <small class="text-muted">@Model.SoDonMuaGoiDoc đơn thành công</small>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-3">Doanh thu theo tháng gần nhất</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tháng</th>
                                <th>Số giao dịch</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dt in Model.DoanhThuTheoThang)
                            {
                                <tr>
                                    <td class="fw-semibold">Tháng @dt.Thang</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">@dt.SoGiaoDich đơn</span></td>
                                    <td class="text-end fw-bold text-success">@dt.DoanhThu.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB LƯỢT XEM: TOP TRUYỆN ĐƯỢC XEM NHIỀU NHẤT -->
    <div class="col-lg-6" id="sectionLuotXem">
        <div class="card shadow-sm border-0 rounded-4 h-100 bg-white">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="fas fa-fire text-danger me-2"></i>Top Truyện Có Lượt Xem Cao Nhất
                </h5>
                <a href="/Admin/TruyenManagement" class="btn btn-sm btn-outline-primary rounded-pill px-3">Tất cả</a>
            </div>
            <div class="card-body p-4">
                <div class="list-group list-group-flush">
                    @{ int rank = 1; }
                    @foreach (var truyen in Model.TopTruyen)
                    {
                        <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge @(rank == 1 ? "bg-danger" : (rank == 2 ? "bg-warning text-dark" : (rank == 3 ? "bg-success" : "bg-light text-dark border"))) rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-weight: bold;">
                                    @rank
                                </span>
                                <img src="@(truyen.AnhBia ?? "/images/default-cover.jpg")" alt="@truyen.TenTruyen"
                                     style="width: 42px; height: 56px; object-fit: cover; border-radius: 6px;" />
                                <div>
                                    <h6 class="fw-bold mb-0 text-truncate" style="max-width: 200px;">@truyen.TenTruyen</h6>
                                    <small class="text-muted d-block">Tác giả: @(string.IsNullOrEmpty(truyen.TacGia) ? "Đang cập nhật" : truyen.TacGia)</small>
                                    <small class="text-muted">@truyen.SoChuong chương • <i class="fas fa-heart text-danger ms-1"></i> @truyen.LuotThich</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-bold">
                                    <i class="fas fa-eye me-1"></i> @truyen.LuotXem.ToString("N0")
                                </span>
                            </div>
                        </div>
                        rank++;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BẢNG LỊCH SỬ GIAO DỊCH GẦN ĐÂY TRONG ADMIN -->
<div class="card shadow-sm border-0 rounded-4 bg-white mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold text-dark mb-1">
                <i class="fas fa-receipt text-primary me-2"></i>Giao Dịch Thanh Toán Gần Đây
            </h5>
            <small class="text-muted">Các đơn mua lẻ truyện và gói đọc mới nhất qua VNPAY / PayPal</small>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã GD</th>
                        <th>Độc Giả</th>
                        <th>Mục Mua</th>
                        <th>Loại</th>
                        <th>Số Tiền</th>
                        <th>Cổng TT</th>
                        <th>Thời Gian</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.GiaoDichMoiNhat.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có giao dịch nào phát sinh.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.GiaoDichMoiNhat)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">#GD@item.MaGiaoDich.ToString("D5")</td>
                                <td class="fw-semibold">@item.TenNguoiDung</td>
                                <td class="fw-bold text-dark">@item.TenMucTieu</td>
                                <td>
                                    @if (item.LoaiGiaoDich == "MuaTruyen" || item.LoaiGiaoDich == "Truyen")
                                    {
                                        <span class="badge rounded-pill px-2 py-1 small" style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;">
                                            <i class="fas fa-book me-1"></i> Mua lẻ truyện
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-2 py-1 small" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                                            <i class="fas fa-crown me-1 text-warning"></i> Gói đọc VIP
                                        </span>
                                    }
                                </td>
                                <td class="fw-bold text-danger">@item.SoTien.ToString("N0") đ</td>
                                <td>
                                    @if (item.PhuongThuc.Equals("PayPal", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
                                            <i class="fab fa-paypal me-1"></i>PayPal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
                                            <i class="fas fa-qrcode me-1"></i>VNPAY
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <i class="fas fa-circle-check me-1"></i> @item.TrangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
