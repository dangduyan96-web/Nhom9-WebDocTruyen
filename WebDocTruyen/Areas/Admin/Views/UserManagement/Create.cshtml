@model WebDocTruyen.Models.NguoiDung

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm Tài Khoản Mới";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-primary"><i class="fas fa-user-plus me-2"></i> Thêm Tài Khoản Mới</h3>

    <form asp-area="Admin" asp-controller="UserManagement" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TenDangNhap" class="form-label fw-bold">Tên Đăng Nhập</label>
            <input asp-for="TenDangNhap" class="form-control form-control-modern" placeholder="Nhập tên đăng nhập..." required />
            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mật Khẩu</label>
            <input type="password" name="matKhau" class="form-control form-control-modern" placeholder="Nhập mật khẩu cho tài khoản..." required />
        </div>

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label fw-bold">Họ Tên</label>
            <input asp-for="HoTen" class="form-control form-control-modern" placeholder="Họ tên người dùng..." />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">Email</label>
            <input asp-for="Email" type="email" class="form-control form-control-modern" placeholder="example@gmail.com" />
        </div>

        <div class="mb-3">
            <label asp-for="MaVaiTro" class="form-label fw-bold">Phân Quyền Vai Trò</label>
            <select asp-for="MaVaiTro" class="form-control form-control-modern" asp-items="ViewBag.VaiTroList">
                <option value="">-- Chọn vai trò --</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i> Lưu Lại</button>
            <a href="/Admin/UserManagement/Index" class="btn btn-secondary">Quay Lại</a>
        </div>
    </form>
</div>
