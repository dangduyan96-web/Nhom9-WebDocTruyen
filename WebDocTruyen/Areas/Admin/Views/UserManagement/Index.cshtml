@model IEnumerable<WebDocTruyen.Models.NguoiDung>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản Lý Tài Khoản";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👥 Quản Lý Tài Khoản Người Dùng</h2>
    <a href="/Admin/UserManagement/Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-1"></i> Thêm Tài Khoản Mới
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Họ Tên</th>
                    <th>Email</th>
                    <th>Vai Trò</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaNguoiDung</td>
                        <td class="fw-bold">@item.TenDangNhap</td>
                        <td>@(string.IsNullOrEmpty(item.HoTen) ? "Chưa cập nhật" : item.HoTen)</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.MaVaiTro == 1 ? "bg-danger" : "bg-info text-dark")">
                                @(item.MaVaiTroNavigation?.TenVaiTro ?? "Thành viên")
                            </span>
                        </td>
                        <td>
                            @if (item.IsKhoa == true)
                            {
                                <span class="badge bg-secondary">Đã khóa</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="admin-actions">
                                <a href="/Admin/UserManagement/Edit/@item.MaNguoiDung" class="btn-action btn-action-edit" title="Sửa">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a href="/Admin/UserManagement/ToggleLock/@item.MaNguoiDung?page=@currentPage"
                                   class="btn-action btn-action-toggle"
                                   onclick="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái tài khoản này không?');" title="Khóa/Mở khóa">
                                    <i class="fas @(item.IsKhoa == true ? "fa-unlock" : "fa-lock")"></i>
                                </a>
                                <a href="/Admin/UserManagement/Delete/@item.MaNguoiDung"
                                   class="btn-action btn-action-delete"
                                   onclick="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản này không?');" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang tối đa 7 mục/trang -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <!-- Nút về trang trước (<) -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })" aria-label="Previous">
                        <span aria-hidden="true">&lt;</span>
                    </a>
                </li>

                <!-- Các số trang -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }

                <!-- Nút sang trang sau (>) -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })" aria-label="Next">
                        <span aria-hidden="true">&gt;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
