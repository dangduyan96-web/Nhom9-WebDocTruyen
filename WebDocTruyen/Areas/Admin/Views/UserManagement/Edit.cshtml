@model WebDocTruyen.Models.NguoiDung

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh Sửa Tài Khoản";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-warning"><i class="fas fa-user-edit me-2"></i> Chỉnh Sửa Thông Tin Tài Khoản</h3>

    <form asp-area="Admin" asp-controller="UserManagement" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="MaNguoiDung" />

        <div class="mb-3">
            <label asp-for="TenDangNhap" class="form-label fw-bold">Tên Đăng Nhập</label>
            <input asp-for="TenDangNhap" class="form-control form-control-modern" readonly style="background-color: #e9ecef;" />
            <small class="text-muted">Tên đăng nhập không thể thay đổi.</small>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mật Khẩu Mới (Tùy chọn)</label>
            <input type="password" name="newPassword" class="form-control form-control-modern" placeholder="Bỏ trống nếu không muốn đổi mật khẩu..." />
        </div>

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label fw-bold">Họ Tên</label>
            <input asp-for="HoTen" class="form-control form-control-modern" />
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">Email</label>
            <input asp-for="Email" type="email" class="form-control form-control-modern" />
        </div>

        <div class="mb-3">
            <label asp-for="MaVaiTro" class="form-label fw-bold">Phân Quyền Vai Trò</label>
            <select asp-for="MaVaiTro" class="form-control form-control-modern" asp-items="ViewBag.VaiTroList"></select>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsKhoa" class="form-check-input" type="checkbox" id="isKhoaCheck" />
            <label class="form-check-label fw-bold text-danger" for="isKhoaCheck">
                Khóa tài khoản này
            </label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-white"><i class="fas fa-save me-1"></i> Cập Nhật</button>
            <a href="/Admin/UserManagement/Index" class="btn btn-secondary">Quay Lại</a>
        </div>
    </form>
</div>
