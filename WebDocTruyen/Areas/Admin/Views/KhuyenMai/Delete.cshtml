@model WebDocTruyen.Models.KhuyenMai

@{
    ViewData["Title"] = "Xác Nhận Xóa Mã Khuyến Mãi";
    Layout = "_LayoutAdmin";
    int luotDung = ViewBag.LuotDung ?? 0;
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <div class="mb-4">
        <h4 class="text-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i> Xác Nhận Xóa Mã Khuyến Mãi</h4>
        <p class="text-muted mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn mã này không? Hành động này không thể hoàn tác.</p>
    </div>

    <div class="border rounded-3 p-3 bg-light mb-4">
        <h5 class="fw-bold text-primary mb-1">@Model.MaGiamGia</h5>
        <p class="mb-1 text-danger fw-bold">Giảm: @Model.SoTienGiam.ToString("N0") đ</p>
        <p class="mb-1 text-muted small">Áp dụng: @Model.NgayBatDau.ToString("dd/MM/yyyy") → @Model.NgayKetThuc.ToString("dd/MM/yyyy")</p>
        <p class="mb-0 small">Đã dùng trong giao dịch: <strong>@luotDung</strong> lần</p>
    </div>

    @if (luotDung > 0)
    {
        <div class="alert alert-warning">
            Mã này đã xuất hiện trong lịch sử giao dịch nên <strong>không thể xóa</strong>. Hãy quay lại và chọn <strong>Tạm dừng</strong> để ngừng áp dụng.
        </div>
        <a href="/Admin/KhuyenMai" class="btn btn-secondary">Quay lại danh sách</a>
    }
    else
    {
        <form method="post" action="@Url.Action("Delete", "KhuyenMai", new { area = "Admin" })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.MaKhuyenMai" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt me-1"></i> Xác Nhận Xóa</button>
                <a href="/Admin/KhuyenMai" class="btn btn-secondary">Hủy Bỏ</a>
            </div>
        </form>
    }
</div>
