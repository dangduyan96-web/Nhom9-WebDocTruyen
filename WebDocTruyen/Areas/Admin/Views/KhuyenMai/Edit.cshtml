@model WebDocTruyen.Areas.Admin.ViewModels.KhuyenMaiFormViewModel

@{
    ViewData["Title"] = "Sửa Mã Khuyến Mãi";
    Layout = "_LayoutAdmin";
    int luotDung = ViewBag.LuotDung ?? 0;
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-primary"><i class="fas fa-ticket-alt me-2"></i> Sửa Mã Khuyến Mãi</h3>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var loi in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@loi.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Edit" asp-route-id="@Model.MaKhuyenMai" method="post">
        <input type="hidden" name="MaKhuyenMai" value="@Model.MaKhuyenMai" />

        <div class="mb-3">
            <label class="form-label fw-bold">Mã Giảm Giá</label>
            <input value="@Model.MaGiamGia" class="form-control form-control-modern" readonly />
            <div class="form-text">
                Không thể đổi mã sau khi tạo. Mã này đã được dùng <strong>@luotDung</strong> lần. Muốn đổi mã, hãy tạo mã mới và tạm dừng mã cũ.
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Số Tiền Giảm (VNĐ)</label>
            <input name="SoTienGiam" value="@(Model.SoTienGiam.HasValue ? Model.SoTienGiam.Value.ToString("0") : "")" type="number" min="1000" step="1000" class="form-control form-control-modern" required />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Ngày Bắt Đầu</label>
                <input name="NgayBatDau" value="@(Model.NgayBatDau?.ToString("yyyy-MM-dd"))" type="date" class="form-control form-control-modern" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Ngày Kết Thúc</label>
                <input name="NgayKetThuc" value="@(Model.NgayKetThuc?.ToString("yyyy-MM-dd"))" type="date" class="form-control form-control-modern" required />
                <div class="form-text">Mã có hiệu lực đến hết ngày này.</div>
            </div>
        </div>

        <div class="form-check mb-4">
            <input name="IsHoatDong" class="form-check-input" type="checkbox" id="IsHoatDong" value="true" @(Model.IsHoatDong ? "checked" : "") />
            <label class="form-check-label fw-bold" for="IsHoatDong">Đang hoạt động</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i> Lưu Thay Đổi</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>
