@model IEnumerable<WebDocTruyen.Areas.Admin.ViewModels.BinhLuanAdminItemVM>

@{
    ViewData["Title"] = "Kiểm Duyệt Bình Luận";
    Layout = "_LayoutAdmin";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string keyword = ViewBag.Keyword ?? "";
    string trangThai = ViewBag.TrangThai ?? "all";
    int tong = ViewBag.TongBinhLuan ?? 0;
    int tongAn = ViewBag.TongAn ?? 0;
    int tongHien = tong - tongAn;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0">💬 Kiểm Duyệt Bình Luận</h3>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}

<!-- Bộ lọc trạng thái -->
<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(trangThai == "all" ? "active" : "")" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", keyword = keyword, trangThai = "all" })">Tất cả (@tong)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(trangThai == "hien" ? "active" : "")" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", keyword = keyword, trangThai = "hien" })">Đang hiển thị (@tongHien)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(trangThai == "an" ? "active" : "")" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", keyword = keyword, trangThai = "an" })">Đã ẩn (@tongAn)</a>
    </li>
</ul>

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <!-- Tìm kiếm -->
    <form method="get" action="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin" })" class="row g-2 mb-3">
        <input type="hidden" name="trangThai" value="@trangThai" />
        <div class="col-md-9">
            <input type="text" name="keyword" value="@keyword" class="form-control form-control-modern" placeholder="Tìm theo nội dung, tên người dùng hoặc tên truyện..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="fas fa-search me-1"></i> Tìm</button>
            @if (!string.IsNullOrEmpty(keyword))
            {
                <a class="btn btn-secondary" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", trangThai = trangThai })">Xóa lọc</a>
            }
        </div>
    </form>

    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">STT</th>
                    <th style="width: 170px;">Người Bình Luận</th>
                    <th>Nội Dung</th>
                    <th style="width: 200px;">Truyện / Chương</th>
                    <th style="width: 130px;">Thời Gian</th>
                    <th style="width: 110px;">Trạng Thái</th>
                    <th style="width: 170px;" class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = (currentPage - 1) * 10 + 1;
                    foreach (var item in Model)
                    {
                        string noiDungRutGon = item.NoiDung.Length > 300 ? item.NoiDung.Substring(0, 300) + "…" : item.NoiDung;
                        <tr class="@(item.IsAn ? "table-light text-muted" : "")">
                            <td class="fw-bold text-muted">@(index++)</td>
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.HoTen) ? item.TenDangNhap : item.HoTen)</div>
                                <div class="small text-muted">@("@" + item.TenDangNhap)</div>
                            </td>
                            <td>
                                <div style="white-space: pre-line; word-break: break-word;" title="@item.NoiDung">@noiDungRutGon</div>
                                <div class="mt-1">
                                    @if (item.LaTraLoi)
                                    {
                                        <span class="badge bg-light text-dark border me-1"><i class="fas fa-reply me-1"></i>Trả lời</span>
                                    }
                                    @if (item.SoTraLoi > 0)
                                    {
                                        <span class="badge bg-light text-dark border"><i class="fas fa-comments me-1"></i>@item.SoTraLoi trả lời</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <a href="/Truyen/Details/@item.MaTruyen" target="_blank" class="fw-semibold text-decoration-none">@item.TenTruyen</a>
                                <div class="small text-muted">Chương @item.SoThuTuChuong</div>
                            </td>
                            <td class="small">@item.NgayTao?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(item.IsAn ? "bg-secondary" : "bg-success")">@(item.IsAn ? "Đã ẩn" : "Hiển thị")</span>
                            </td>
                            <td class="text-end">
                                <div class="admin-actions">
                                    <a href="/Truyen/Details/@item.MaTruyen" target="_blank" class="btn-action btn-action-view">
                                        <i class="fas fa-eye"></i> Xem
                                    </a>
                                    <form method="post" class="d-inline"
                                          action="@Url.Action("ToggleAn", "BinhLuanManagement", new { area = "Admin", id = item.MaBinhLuan, keyword = keyword, trangThai = trangThai, page = currentPage })"
                                          onsubmit="return confirm('@(item.IsAn ? "Hiện lại bình luận này?" : "Ẩn bình luận này khỏi trang truyện?")');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="@(item.IsAn ? "btn-action btn-action-edit" : "btn-action btn-action-delete")">
                                            @(item.IsAn ? "Hiện lại" : "Ẩn")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không có bình luận nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", page = currentPage - 1, keyword = keyword, trangThai = trangThai })">&lt;</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", page = i, keyword = keyword, trangThai = trangThai })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", "BinhLuanManagement", new { area = "Admin", page = currentPage + 1, keyword = keyword, trangThai = trangThai })">&gt;</a>
                </li>
            </ul>
        </nav>
    }
</div>
