@model WebDocTruyen.Models.QuocGiaItem
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm Quốc Gia Mới";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto" style="max-width: 600px;">
    <h4 class="mb-4 text-danger fw-bold"><i class="bi bi-globe-americas me-2"></i> Thêm Quốc Gia Truyện</h4>

    <form asp-area="Admin" asp-controller="QuocGiaManagement" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tên Quốc Gia <span class="text-danger">*</span></label>
            <input asp-for="TenQuocGia" class="form-control form-control-modern" placeholder="Ví dụ: Trung Quốc, Hàn Quốc, Nhật Bản..." required />
            <span asp-validation-for="TenQuocGia" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mã ISO / Ký Hiệu (Tùy chọn)</label>
            <input asp-for="MaIso" class="form-control form-control-modern" placeholder="Ví dụ: VN, CN, KR, JP, US..." />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Mô Tả / Ghi Chú</label>
            <textarea asp-for="MoTa" class="form-control form-control-modern" rows="3" placeholder="Ví dụ: Truyện tranh Manhwa, Manga, Tiên hiệp..."></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger fw-bold px-4"><i class="fas fa-save me-1"></i> Lưu Quốc Gia</button>
            <a href="/Admin/QuocGiaManagement" class="btn btn-secondary px-4">Quay Lại</a>
        </div>
    </form>
</div>
