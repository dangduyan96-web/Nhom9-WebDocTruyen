@model WebDocTruyen.Models.QuocGiaItem
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xác Nhận Xóa Quốc Gia";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto text-center" style="max-width: 500px;">
    <div class="text-danger mb-3">
        <i class="fas fa-exclamation-triangle fa-3x"></i>
    </div>
    <h4 class="fw-bold mb-3">Xóa Quốc Gia Truyện?</h4>
    <p class="text-muted">Bạn có chắc chắn muốn xóa quốc gia <strong>@Model.TenQuocGia</strong> khỏi danh sách không?</p>

    <form asp-area="Admin" asp-controller="QuocGiaManagement" asp-action="Delete" asp-route-id="@Model.MaQuocGia" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-center gap-2">
            <button type="submit" class="btn btn-danger fw-bold px-4">Đồng Ý Xóa</button>
            <a href="/Admin/QuocGiaManagement" class="btn btn-secondary px-4">Hủy Bỏ</a>
        </div>
    </form>
</div>
