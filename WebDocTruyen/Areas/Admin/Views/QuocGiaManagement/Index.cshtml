@model List<WebDocTruyen.Models.QuocGiaItem>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản Lý Quốc Gia Truyện";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title"><i class="bi bi-globe-americas me-2 text-danger"></i> Quản Lý Quốc Gia Truyện</h2>
        <p class="text-muted small mb-0">Quản lý danh sách các quốc gia xuất xứ của truyện (Trung Quốc, Hàn Quốc, Nhật Bản, Việt Nam, Mỹ, ...)</p>
    </div>
    <a href="/Admin/QuocGiaManagement/Create" class="btn btn-danger rounded-pill px-4 fw-bold">
        <i class="fas fa-plus me-1"></i> Thêm Quốc Gia
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-card">
    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã</th>
                    <th>Tên Quốc Gia</th>
                    <th>Mã ISO</th>
                    <th>Mô Tả / Đặc Điểm</th>
                    <th class="text-end" style="width: 160px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted fw-bold">#@item.MaQuocGia</td>
                            <td>
                                <strong class="text-dark fs-6">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @item.TenQuocGia
                                </strong>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@(string.IsNullOrEmpty(item.MaIso) ? "--" : item.MaIso)</span>
                            </td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td>
                            <td class="text-end">
                                <div class="admin-actions">
                                    <a href="/Admin/QuocGiaManagement/Edit/@item.MaQuocGia" class="btn-action btn-action-edit">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <a href="/Admin/QuocGiaManagement/Delete/@item.MaQuocGia" class="btn-action btn-action-delete">
                                        <i class="fas fa-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Chưa có quốc gia nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
