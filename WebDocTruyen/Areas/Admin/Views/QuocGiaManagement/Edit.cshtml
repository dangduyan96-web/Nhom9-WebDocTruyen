@model WebDocTruyen.Models.QuocGiaItem
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh Sửa Quốc Gia";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto" style="max-width: 600px;">
    <h4 class="mb-4 text-warning fw-bold"><i class="fas fa-edit me-2"></i> Chỉnh Sửa Quốc Gia</h4>

    <form asp-area="Admin" asp-controller="QuocGiaManagement" asp-action="Edit" asp-route-id="@Model.MaQuocGia" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaQuocGia" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tên Quốc Gia <span class="text-danger">*</span></label>
            <input asp-for="TenQuocGia" class="form-control form-control-modern" required />
            <span asp-validation-for="TenQuocGia" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mã ISO / Ký Hiệu</label>
            <input asp-for="MaIso" class="form-control form-control-modern" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Mô Tả / Ghi Chú</label>
            <textarea asp-for="MoTa" class="form-control form-control-modern" rows="3"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-white fw-bold px-4"><i class="fas fa-save me-1"></i> Cập Nhật</button>
            <a href="/Admin/QuocGiaManagement" class="btn btn-secondary px-4">Quay Lại</a>
        </div>
    </form>
</div>
