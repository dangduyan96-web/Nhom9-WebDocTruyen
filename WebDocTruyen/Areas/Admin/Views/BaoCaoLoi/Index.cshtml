@model IEnumerable<WebDocTruyen.Models.BaoCaoLoi>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản Lý Báo Cáo Lỗi";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentStatus = ViewBag.CurrentStatus ?? "All";
    string currentLoaiLoi = ViewBag.CurrentLoaiLoi ?? "All";
    string currentSearch = ViewBag.CurrentSearch ?? "";

    int countTotal = ViewBag.CountTotal ?? 0;
    int countChoXuLy = ViewBag.CountChoXuLy ?? 0;
    int countDangXuLy = ViewBag.CountDangXuLy ?? 0;
    int countDaGiaiQuyet = ViewBag.CountDaGiaiQuyet ?? 0;
    int countDaHuy = ViewBag.CountDaHuy ?? 0;
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">⚠️ Quản Lý Báo Cáo Lỗi Chương Truyện</h2>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a href="@Url.Action("Index", new { status = "All" })" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white @(currentStatus == "All" ? "border-primary border-2 border" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Tất Cả</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@countTotal</div>
                    </div>
                    <div class="rounded-3 p-3 bg-light text-primary fs-4">
                        <i class="fas fa-list-alt"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a href="@Url.Action("Index", new { status = "Chờ xử lý" })" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white @(currentStatus == "Chờ xử lý" ? "border-warning border-2 border" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Chờ Xử Lý</div>
                        <div class="fs-3 fw-bold text-warning mt-1">@countChoXuLy</div>
                    </div>
                    <div class="rounded-3 p-3 bg-warning-subtle text-warning fs-4">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a href="@Url.Action("Index", new { status = "Đang xử lý" })" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white @(currentStatus == "Đang xử lý" ? "border-info border-2 border" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Đang Xử Lý</div>
                        <div class="fs-3 fw-bold text-info mt-1">@countDangXuLy</div>
                    </div>
                    <div class="rounded-3 p-3 bg-info-subtle text-info fs-4">
                        <i class="fas fa-spinner fa-spin-pulse"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-3">
        <a href="@Url.Action("Index", new { status = "Đã giải quyết" })" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white @(currentStatus == "Đã giải quyết" ? "border-success border-2 border" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Đã Giải Quyết</div>
                        <div class="fs-3 fw-bold text-success mt-1">@countDaGiaiQuyet</div>
                    </div>
                    <div class="rounded-3 p-3 bg-success-subtle text-success fs-4">
                        <i class="fas fa-check-double"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Bộ lọc và Tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" action="@Url.Action("Index")" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Tìm tên truyện, chương, nội dung..." value="@currentSearch" />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <select name="status" class="form-select bg-light">
                <option value="All" selected="@(currentStatus == "All")">-- Tất cả trạng thái --</option>
                <option value="Chờ xử lý" selected="@(currentStatus == "Chờ xử lý")">Chờ xử lý</option>
                <option value="Đang xử lý" selected="@(currentStatus == "Đang xử lý")">Đang xử lý</option>
                <option value="Đã giải quyết" selected="@(currentStatus == "Đã giải quyết")">Đã giải quyết</option>
                <option value="Đã hủy" selected="@(currentStatus == "Đã hủy")">Đã hủy / Bỏ qua</option>
            </select>
        </div>

        <div class="col-6 col-md-3">
            <select name="loaiLoi" class="form-select bg-light">
                <option value="All" selected="@(currentLoaiLoi == "All")">-- Tất cả loại lỗi --</option>
                <option value="Lỗi nội dung / chữ bị nhảy" selected="@(currentLoaiLoi == "Lỗi nội dung / chữ bị nhảy")">Lỗi nội dung / chữ bị nhảy</option>
                <option value="Sai thứ tự chương" selected="@(currentLoaiLoi == "Sai thứ tự chương")">Sai thứ tự chương</option>
                <option value="Lỗi hình ảnh / ảnh die" selected="@(currentLoaiLoi == "Lỗi hình ảnh / ảnh die")">Lỗi hình ảnh / ảnh die</option>
                <option value="Chương trống không có chữ" selected="@(currentLoaiLoi == "Chương trống không có chữ")">Chương trống không có chữ</option>
                <option value="Lỗi chính tả / dịch thuật kém" selected="@(currentLoaiLoi == "Lỗi chính tả / dịch thuật kém")">Lỗi chính tả / dịch thuật</option>
                <option value="Khác" selected="@(currentLoaiLoi == "Khác")">Khác</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-filter me-1"></i> Lọc
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                <i class="fas fa-rotate"></i>
            </a>
        </div>
    </form>
</div>

<!-- Bảng danh sách báo cáo lỗi -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">Mã</th>
                    <th>Truyện & Chương Lỗi</th>
                    <th>Phân Loại Lỗi</th>
                    <th>Mô Tả Của Độc Giả</th>
                    <th>Người Báo & Thời Gian</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Xử Lý</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-clipboard-check fs-1 text-secondary mb-3 d-block"></i>
                            Không có báo cáo lỗi nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-secondary">#@item.MaBaoCao</td>
                        <td>
                            <div class="fw-bold text-dark">@(item.MaTruyenNavigation?.TenTruyen ?? "Truyện không tồn tại")</div>
                            <div class="small text-muted d-flex align-items-center gap-1 mt-1">
                                <span>Chương @(item.MaChuongNavigation?.SoThuTuChuong): @(item.MaChuongNavigation?.TieuDe)</span>
                                @if (item.MaChuong > 0)
                                {
                                    <a href="/Truyen/Doc/@item.MaChuong" target="_blank" class="badge bg-light text-primary border text-decoration-none ms-1" title="Mở đọc chương để kiểm tra lỗi">
                                        <i class="fas fa-external-link-alt"></i> Kiểm tra
                                    </a>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                <i class="fas fa-triangle-exclamation me-1"></i> @item.LoaiLoi
                            </span>
                        </td>
                        <td style="max-width: 250px;">
                            <div class="text-truncate" title="@item.MoTaChiTiet">
                                @(string.IsNullOrEmpty(item.MoTaChiTiet) ? "<Không có mô tả chi tiết>" : item.MoTaChiTiet)
                            </div>
                            @if (!string.IsNullOrEmpty(item.GhiChuAdmin))
                            {
                                <div class="small text-success mt-1">
                                    <i class="fas fa-comment-dots me-1"></i> Admin: @item.GhiChuAdmin
                                </div>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">
                                @(item.MaNguoiDungNavigation?.HoTen ?? item.TenNguoiBaoCao ?? "Độc giả ẩn danh")
                            </div>
                            <div class="small text-muted">
                                @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </td>
                        <td>
                            @if (item.TrangThai == "Chờ xử lý")
                            {
                                <span class="badge bg-warning text-dark px-2 py-1">
                                    <i class="fas fa-clock me-1"></i> Chờ xử lý
                                </span>
                            }
                            else if (item.TrangThai == "Đang xử lý")
                            {
                                <span class="badge bg-info text-dark px-2 py-1">
                                    <i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý
                                </span>
                            }
                            else if (item.TrangThai == "Đã giải quyết")
                            {
                                <span class="badge bg-success px-2 py-1">
                                    <i class="fas fa-check-circle me-1"></i> Đã giải quyết
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-2 py-1">
                                    <i class="fas fa-ban me-1"></i> Đã hủy
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="admin-actions">
                                <a href="@Url.Action("Details", new { id = item.MaBaoCao })" class="btn-action btn-action-view" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i> Xem
                                </a>

                                <button type="button" class="btn-action btn-action-edit" data-bs-toggle="modal" data-bs-target="#modalXuLy-@item.MaBaoCao" title="Cập nhật trạng thái">
                                    <i class="fas fa-edit"></i> Xử lý
                                </button>

                                <form method="post" action="@Url.Action("Delete", new { id = item.MaBaoCao })" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn báo cáo này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-action btn-action-delete" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Modal Xử lý nhanh trạng thái -->
                            <div class="modal fade text-start" id="modalXuLy-@item.MaBaoCao" tabindex="-1" aria-labelledby="label-@item.MaBaoCao" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <form method="post" action="@Url.Action("UpdateStatus")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MaBaoCao" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                                            <div class="modal-header border-bottom-0 pb-0">
                                                <h5 class="modal-title fw-bold" id="label-@item.MaBaoCao">
                                                    Xử lý báo cáo #@item.MaBaoCao
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label text-muted small fw-bold">TRUYỆN & CHƯƠNG BỊ LỖI</label>
                                                    <div class="p-2 bg-light rounded-3">
                                                        <div class="fw-bold">@item.MaTruyenNavigation?.TenTruyen</div>
                                                        <div class="small text-muted">Chương @item.MaChuongNavigation?.SoThuTuChuong: @item.MaChuongNavigation?.TieuDe</div>
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Trạng thái xử lý <span class="text-danger">*</span></label>
                                                    <select name="trangThai" class="form-select">
                                                        <option value="Chờ xử lý" selected="@(item.TrangThai == "Chờ xử lý")">Chờ xử lý</option>
                                                        <option value="Đang xử lý" selected="@(item.TrangThai == "Đang xử lý")">Đang xử lý (Đang sửa chương)</option>
                                                        <option value="Đã giải quyết" selected="@(item.TrangThai == "Đã giải quyết")">Đã giải quyết (Đã fix xong)</option>
                                                        <option value="Đã hủy" selected="@(item.TrangThai == "Đã hủy")">Đã hủy (Báo lỗi sai/spam)</option>
                                                    </select>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Ghi chú xử lý của Admin</label>
                                                    <textarea name="ghiChuAdmin" class="form-control" rows="3" placeholder="Nhập ghi chú hoặc phản hồi (VD: Đã re-upload lại chương 1, văn bản đã căn chỉnh)">@item.GhiChuAdmin</textarea>
                                                </div>
                                            </div>

                                            <div class="modal-footer border-top-0 pt-0">
                                                <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Đóng</button>
                                                <button type="submit" class="btn btn-primary rounded-3 px-4">
                                                    <i class="fas fa-save me-1"></i> Lưu Thay Đổi
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, status = currentStatus, loaiLoi = currentLoaiLoi, search = currentSearch })">
                        &lt;
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, status = currentStatus, loaiLoi = currentLoaiLoi, search = currentSearch })">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, status = currentStatus, loaiLoi = currentLoaiLoi, search = currentSearch })">
                        &gt;
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
