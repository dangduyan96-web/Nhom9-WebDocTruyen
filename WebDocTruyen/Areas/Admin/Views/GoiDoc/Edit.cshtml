@model WebDocTruyen.Models.GoiDoc
@{
    ViewData["Title"] = "Sửa gói cước tháng";
    Layout = "_LayoutAdmin";
}
<div class="mb-4">
    <h2 class="fw-bold mb-1">Sửa gói cước tháng</h2>
    <p class="text-muted mb-0">Cập nhật giá, thời hạn, phạm vi quyền đọc hoặc trạng thái mở bán.</p>
</div>
<div class="card border-0 shadow-sm" style="max-width:760px">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.MaGoiDoc" method="post">
            <input asp-for="MaGoiDoc" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="TenGoi" class="form-label fw-semibold">Tên gói</label>
                <input asp-for="TenGoi" class="form-control" maxlength="100" />
                <span asp-validation-for="TenGoi" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SoNgayHieuLuc" class="form-label fw-semibold">Thời hạn (ngày)</label>
                    <input asp-for="SoNgayHieuLuc" type="number" min="1" class="form-control" />
                    <span asp-validation-for="SoNgayHieuLuc" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GiaTien" class="form-label fw-semibold">Giá (VNĐ)</label>
                    <input asp-for="GiaTien" type="number" min="0" step="1000" class="form-control" />
                    <span asp-validation-for="GiaTien" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="MoTa" class="form-label fw-semibold">Mô tả / phạm vi quyền đọc</label>
                <textarea asp-for="MoTa" class="form-control" rows="4" maxlength="500"></textarea>
                <div class="form-text">Quyền đọc hiện áp dụng cho các chương trả phí trên hệ thống khi gói còn hạn.</div>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="IsHoatDong" class="form-check-input" />
                <label asp-for="IsHoatDong" class="form-check-label">Đang mở bán</label>
            </div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
        </form>
    </div>
</div>
