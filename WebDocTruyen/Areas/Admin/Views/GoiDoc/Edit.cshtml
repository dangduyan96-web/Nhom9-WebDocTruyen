@model WebDocTruyen.Models.GoiDoc

@{
    ViewData["Title"] = "Chỉnh sửa Gói Đọc";
    Layout = "_LayoutAdmin";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-warning"><i class="fas fa-edit me-2"></i> Chỉnh Sửa Gói Cước: @Model.TenGoi</h3>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MaGoiDoc" />

        <div class="mb-3">
            <label asp-for="TenGoi" class="form-label fw-bold">Tên Gói Đọc</label>
            <input asp-for="TenGoi" class="form-control form-control-modern" placeholder="VD: Gói VIP 30 Ngày" required />
            <span asp-validation-for="TenGoi" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="SoNgayHieuLuc" class="form-label fw-bold">Số Ngày Hiệu Lực</label>
                <input asp-for="SoNgayHieuLuc" type="number" class="form-control form-control-modern" min="1" required />
                <span asp-validation-for="SoNgayHieuLuc" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="GiaTien" class="form-label fw-bold">Giá Tiền (VNĐ)</label>
                <input asp-for="GiaTien" type="number" step="1000" class="form-control form-control-modern" required />
                <span asp-validation-for="GiaTien" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MoTa" class="form-label fw-bold">Mô Tả Gói</label>
            <textarea asp-for="MoTa" class="form-control form-control-modern" rows="3" placeholder="Nhập mô tả lợi ích gói..."></textarea>
        </div>

        <div class="form-check mb-4">
            <input name="IsHoatDong" class="form-check-input" type="checkbox" id="IsHoatDong" value="true" @(Model?.IsHoatDong == true ? "checked" : "") />
            <label class="form-check-label fw-bold" for="IsHoatDong">Đang hoạt động (Kích hoạt mở bán)</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-white"><i class="fas fa-save me-1"></i> Lưu Thay Đổi</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>
