@model WebDocTruyen.Models.GoiDoc

@{
    ViewData["Title"] = "Thêm Gói Đọc";
    Layout = "_LayoutAdmin";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-primary"><i class="fas fa-gem me-2"></i> Thêm Gói Đọc Mới</h3>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="TenGoi" class="form-label fw-bold">Tên Gói Đọc</label>
            <input asp-for="TenGoi" class="form-control form-control-modern" placeholder="VD: Gói VIP 30 Ngày" required />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="SoNgayHieuLuc" class="form-label fw-bold">Số Ngày Hiệu Lực</label>
                <input asp-for="SoNgayHieuLuc" type="number" class="form-control form-control-modern" min="1" value="30" required />
            </div>

            <div class="col-md-6">
                <label asp-for="GiaTien" class="form-label fw-bold">Giá Tiền (VNĐ)</label>
                <input asp-for="GiaTien" type="number" step="1000" class="form-control form-control-modern" placeholder="50000" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="MoTa" class="form-label fw-bold">Mô Tả Gói</label>
            <textarea asp-for="MoTa" class="form-control form-control-modern" rows="3" placeholder="Nhập mô tả lợi ích gói..."></textarea>
        </div>

        <div class="form-check mb-4">
            <input name="IsHoatDong" class="form-check-input" type="checkbox" id="IsHoatDong" value="true" checked />
            <label class="form-check-label fw-bold" for="IsHoatDong">Kích hoạt mở bán ngay</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i> Lưu Gói Cước</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>
