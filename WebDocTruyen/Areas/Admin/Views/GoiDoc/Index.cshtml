@model IEnumerable<WebDocTruyen.Models.GoiDoc>

@{
    ViewData["Title"] = "Quản lý Gói Đọc";
    Layout = "_Layout";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Chính Sách Giá - Quản Lý Gói Đọc</h3>
        <!-- Đã sửa thành href cứng -->
        <a href="/Admin/GoiDoc/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Thêm Gói Mới</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Tên Gói Cước</th>
                        <th>Số Ngày Hiệu Lực</th>
                        <th>Giá Tiền (VNĐ)</th>
                        <th>Mô Tả</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td class="fw-bold text-primary">@item.TenGoi</td>
                                <td>@item.SoNgayHieuLuc ngày</td>
                                <td class="text-danger fw-bold">@item.GiaTien.ToString("N0") đ</td>
                                <td>@item.MoTa</td>
                                <td>
                                    <span class="badge @(item.IsHoatDong == true ? "bg-success" : "bg-secondary")">
                                        @(item.IsHoatDong == true ? "Đang hoạt động" : "Tạm ẩn")
                                    </span>
                                </td>
                                <td>
                                    <!-- Đã sửa thành href cứng truyền Id -->
                                    <a href="/Admin/GoiDoc/Edit/@item.MaGoiDoc" class="btn btn-sm btn-outline-warning">Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có gói đọc nào được thiết lập.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>