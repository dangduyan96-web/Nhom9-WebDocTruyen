@model IEnumerable<WebDocTruyen.Models.GoiDoc>

@{
    ViewData["Title"] = "Quản lý Gói Đọc";
    Layout = "_LayoutAdmin";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">💎 Chính Sách Giá - Quản Lý Gói Đọc</h3>
    <a href="/Admin/GoiDoc/Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
        <i class="fas fa-plus me-1"></i> Thêm Gói Mới
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table admin-table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">STT</th>
                    <th>Tên Gói Cước</th>
                    <th style="width: 150px;">Số Ngày Hiệu Lực</th>
                    <th style="width: 150px;">Giá Tiền (VNĐ)</th>
                    <th>Mô Tả</th>
                    <th style="width: 130px;">Người Đăng Ký</th>
                    <th style="width: 140px;">Trạng Thái</th>
                    <th style="width: 200px;" class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = (currentPage - 1) * 7 + 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@(index++)</td>
                            <td class="fw-bold text-primary">@item.TenGoi</td>
                            <td>@item.SoNgayHieuLuc ngày</td>
                            <td class="text-danger fw-bold">@item.GiaTien.ToString("N0") đ</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    <i class="fas fa-users me-1 text-secondary"></i>@(item.NguoiDungGoiDocs?.Count ?? 0)
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.IsHoatDong == true ? "bg-success" : "bg-secondary")">
                                    @(item.IsHoatDong == true ? "Đang hoạt động" : "Tạm ẩn")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="admin-actions">
                                    <a href="/Admin/GoiDoc/Edit/@item.MaGoiDoc" class="btn-action btn-action-edit">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>

                                    <form method="post" action="/Admin/GoiDoc/ToggleHoatDong/@item.MaGoiDoc?page=@currentPage" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-action-toggle">
                                            @(item.IsHoatDong == true ? "Tạm ẩn" : "Mở bán")
                                        </button>
                                    </form>

                                    <a href="/Admin/GoiDoc/Delete/@item.MaGoiDoc" class="btn-action btn-action-delete">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Chưa có gói đọc nào được thiết lập.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang tối đa 7 mục/trang -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <!-- Nút về trang trước (<) -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })" aria-label="Previous">
                        <span aria-hidden="true">&lt;</span>
                    </a>
                </li>

                <!-- Các số trang -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }

                <!-- Nút sang trang sau (>) -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })" aria-label="Next">
                        <span aria-hidden="true">&gt;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
