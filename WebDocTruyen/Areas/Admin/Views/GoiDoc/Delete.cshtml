@model WebDocTruyen.Models.GoiDoc

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xác Nhận Xóa Gói Đọc";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <div class="mb-4">
        <h4 class="text-danger fw-bold">
            <i class="fas fa-exclamation-triangle me-2"></i> Xác Nhận Xóa Gói Đọc
        </h4>
        <p class="text-muted mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn gói đọc này không? Hành động này không thể hoàn tác.</p>
    </div>

    <div class="border rounded-3 p-3 bg-light mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold text-primary mb-1">@Model.TenGoi</h5>
                <p class="mb-1 text-muted small">Thời hạn hiệu lực: <strong>@Model.SoNgayHieuLuc ngày</strong></p>
                <p class="mb-1 text-danger fw-bold">Giá cước: @Model.GiaTien.ToString("N0") đ</p>
                @if (!string.IsNullOrEmpty(Model.MoTa))
                {
                    <p class="mb-0 text-secondary small">Mô tả: @Model.MoTa</p>
                }
            </div>
            <div class="text-end">
                <span class="badge bg-info text-dark">Số người đang đăng ký: @Model.NguoiDungGoiDocs.Count</span>
            </div>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="GoiDoc" asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaGoiDoc" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt me-1"></i> Xác Nhận Xóa
            </button>
            <a href="/Admin/GoiDoc/Index" class="btn btn-secondary">Hủy Bỏ</a>
        </div>
    </form>
</div>