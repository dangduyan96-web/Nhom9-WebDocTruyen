@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var adminUser = HttpContextAccessor.HttpContext?.Session.GetString("TaiKhoan") ?? "Quản trị viên";
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro") ?? "Quản trị hệ thống";

    // Lấy tên Controller và Action hiện tại để tự động highlight menu đang active
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Quản Trị WebDocTruyen</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #e8392a;
            --brand-light: #fef2f2;
            --bg-body: #f8fafc;
            --text-main: #334155;
            --text-dark: #0f172a;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Inter', sans-serif !important;
            background-color: var(--bg-body) !important;
            color: var(--text-main);
        }

        #wrapper {
            display: flex;
        }

        /* Sidebar Customization */
        .sidebar-white {
            background-color: #ffffff !important;
            border-right: 1px solid var(--border-color);
            min-height: 100vh;
            width: 260px !important;
            flex-shrink: 0;
        }

        .sidebar-brand-white {
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
            color: var(--text-dark) !important;
            text-decoration: none;
            border-bottom: 1px solid var(--border-color);
        }

            .sidebar-brand-white i {
                color: var(--brand);
                font-size: 22px;
            }

        .app-sidebar-wrap {
            padding: 20px 0;
        }

        .app-sidebar__user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px 20px 20px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 16px;
        }

        .app-sidebar__user-avatar {
            border-radius: 12px !important;
            border: 1.5px solid var(--border-color);
            padding: 2px;
            background: #fff;
            object-fit: cover;
        }

        .app-sidebar__user-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
        }

        .app-sidebar__user-designation {
            font-size: 12px;
            color: #64748b;
            margin: 0;
        }

        .app-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .app-menu__item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            color: #334155 !important;
            font-size: 14px;
            font-weight: 700 !important;
            text-decoration: none;
            transition: all 0.25s ease;
            border-left: 4px solid transparent;
            border-radius: 0 8px 8px 0;
            margin-right: 10px;
            background: none;
            border-top: none;
            border-right: none;
            border-bottom: none;
            width: 100%;
            text-align: left;
        }

            .app-menu__item i {
                color: #475569 !important;
                font-size: 16px;
                min-width: 24px;
            }

            .app-menu__item:hover {
                background-color: #f1f5f9;
                color: var(--brand) !important;
                text-decoration: none;
                padding-left: 28px;
            }

                .app-menu__item:hover i {
                    color: var(--brand) !important;
                }

            .app-menu__item.active {
                background-color: var(--brand-light);
                color: var(--brand) !important;
                border-left-color: var(--brand);
            }

                .app-menu__item.active i {
                    color: var(--brand) !important;
                }

        .sidebar-divider {
            border-top: 1px solid #f1f5f9 !important;
            margin: 8px 0;
            opacity: 0.6;
        }

        /* Topbar Customization */
        .topbar {
            height: 70px;
            background-color: #ffffff !important;
            border-bottom: 1px solid var(--border-color);
        }

        .dropdown-toggle-custom {
            background: none !important;
            border: none !important;
            padding: 0 !important;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-dark) !important;
        }

            .dropdown-toggle-custom::after {
                display: none;
            }

        .img-profile-custom {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--border-color);
        }

        #content-wrapper {
            background-color: var(--bg-body);
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .container-fluid-content {
            padding: 30px;
        }
    </style>
</head>
<body id="page-top">
    <div id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar-white" id="accordionSidebar">
            <a class="sidebar-brand-white" href="/Admin/Dashboard">
                <i class="bi bi-shield-lock-fill"></i>
                <span>QUẢN TRỊ VIÊN</span>
            </a>

            <div class="app-sidebar-wrap">
                <div class="app-sidebar__user">
                    <img class="app-sidebar__user-avatar" src="https://yinnepal.files.wordpress.com/2017/11/admin.png?w=60" width="44" height="44" alt="User Image">
                    <div>
                        <p class="app-sidebar__user-name">@adminUser</p>
                        <p class="app-sidebar__user-designation">@vaiTro</p>
                    </div>
                </div>

                <ul class="app-menu">
                    <li>
                        <a class="app-menu__item @(currentController == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">
                            <i class="bi bi-speedometer2 mr-2"></i>
                            <span>Trang Tổng Quan</span>
                        </a>
                    </li>

                    <div class="sidebar-divider"></div>

                    <li>
                        <a class="app-menu__item @(currentController == "TruyenManagement" ? "active" : "")" href="/Admin/TruyenManagement">
                            <i class="bi bi-book mr-2"></i>
                            <span>Quản Lý Truyện</span>
                        </a>
                    </li>
                    <li>
                        <a class="app-menu__item @(currentController == "Categories" ? "active" : "")" href="/Admin/Categories">
                            <i class="bi bi-tags mr-2"></i>
                            <span>Quản Lý Thể Loại</span>
                        </a>
                    </li>
                    <li>
                        <a class="app-menu__item @(currentController == "ControlUser" ? "active" : "")" href="/Admin/ControlUser">
                            <i class="bi bi-people mr-2"></i>
                            <span>Quản Lý Tài Khoản</span>
                        </a>
                    </li>

                    <div class="sidebar-divider"></div>

                    <li>
                        <a class="app-menu__item text-danger" href="/Account/Logout">
                            <i class="bi bi-box-arrow-right mr-2"></i>
                            <span>Đăng Xuất</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Main Content Area -->
        <div id="content-wrapper">
            <nav class="navbar navbar-expand navbar-light topbar mb-4 static-top px-4 justify-content-end">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item dropdown no-arrow">
                        <div class="dropdown">
                            <button class="dropdown-toggle dropdown-toggle-custom" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-700 font-weight-bold">@adminUser</span>
                                <img class="img-profile-custom" src="https://yinnepal.files.wordpress.com/2017/11/admin.png?w=60" alt="Admin Avatar">
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="dropdownMenuButton1" style="border-radius:10px; margin-top:10px;">
                                <li>
                                    <a class="dropdown-item text-danger font-weight-bold" href="/Account/Logout">
                                        <i class="bi bi-box-arrow-right mr-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </nav>

            <div class="container-fluid-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>