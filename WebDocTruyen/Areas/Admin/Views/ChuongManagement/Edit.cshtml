@model WebDocTruyen.Models.ChuongTruyen

@{
    Layout = "_LayoutAdmin";
    var truyen = (WebDocTruyen.Models.Truyen)ViewBag.Truyen;
    ViewData["Title"] = "Chỉnh Sửa Chương";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white mx-auto" style="max-width: 1000px">
    <h3 class="mb-1 text-warning"><i class="fas fa-edit me-2"></i> Chỉnh Sửa Chương</h3>
    <div class="text-muted mb-4">Truyện: <strong>@truyen.TenTruyen</strong></div>

    <form asp-area="Admin" asp-controller="ChuongManagement" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="MaTruyen" />
        <input type="hidden" asp-for="MaChuong" />

        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="SoThuTuChuong" class="form-label fw-bold">Số Thứ Tự Chương</label>
                <input asp-for="SoThuTuChuong" type="number" min="1" class="form-control" />
                <span asp-validation-for="SoThuTuChuong" class="text-danger"></span>
            </div>
            <div class="col-md-9 mb-3">
                <label asp-for="TieuDe" class="form-label fw-bold">Tiêu Đề</label>
                <input asp-for="TieuDe" class="form-control" maxlength="255" required />
                <span asp-validation-for="TieuDe" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Loại Chương</label>
            <select asp-for="MienPhi" class="form-control">
                <option value="true">Miễn phí</option>
                <option value="false">Trả phí</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="NoiDung" class="form-label fw-bold">Nội Dung</label>
            <textarea asp-for="NoiDung" id="noiDung" class="form-control" rows="15"></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-white"><i class="fas fa-save me-1"></i> Cập Nhật</button>
            <a href="/Admin/ChuongManagement/Index?maTruyen=@Model.MaTruyen" class="btn btn-secondary">Quay Lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('noiDung', { height: 450, language: 'vi' });
    </script>
}
