@model WebDocTruyen.Models.ChuongTruyen

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Xóa Chương";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white mx-auto" style="max-width: 600px">
    <h3 class="mb-3 text-danger"><i class="fas fa-exclamation-triangle me-2"></i> Xác Nhận Xóa Chương</h3>
    <p class="text-muted">Bạn có chắc chắn muốn xóa vĩnh viễn chương này không? Bình luận và tiến độ đọc liên quan cũng sẽ bị xóa. Hành động này không thể hoàn tác.</p>

    <div class="card p-3 mb-4 bg-light border-0">
        <h5 class="fw-bold mb-1">Chương @Model.SoThuTuChuong: @Model.TieuDe</h5>
        <p class="mb-0 text-muted small">Truyện: @Model.MaTruyenNavigation.TenTruyen</p>
    </div>

    <form asp-area="Admin" asp-controller="ChuongManagement" asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaChuong" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash me-1"></i> Xác Nhận Xóa</button>
            <a href="/Admin/ChuongManagement/Index?maTruyen=@Model.MaTruyen" class="btn btn-secondary">Hủy Bỏ</a>
        </div>
    </form>
</div>
