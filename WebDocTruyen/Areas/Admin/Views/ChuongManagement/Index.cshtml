@model IEnumerable<WebDocTruyen.Models.ChuongTruyen>

@{
    Layout = "_LayoutAdmin";
    var truyen = (WebDocTruyen.Models.Truyen)ViewBag.Truyen;
    ViewData["Title"] = "Quản Lý Chương - " + truyen.TenTruyen;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">📖 Quản Lý Chương</h2>
        <div class="text-muted">Truyện: <strong>@truyen.TenTruyen</strong></div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/TruyenManagement" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Danh sách truyện
        </a>
        <a href="/Admin/ChuongManagement/Create?maTruyen=@truyen.MaTruyen" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm Chương Mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:90px">Chương</th>
                    <th>Tiêu Đề</th>
                    <th>Loại</th>
                    <th>Lượt Xem</th>
                    <th>Ngày Phát Hành</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.SoThuTuChuong</td>
                        <td>@item.TieuDe</td>
                        <td>
                            <span class="badge @(item.MienPhi ? "bg-success" : "bg-warning text-dark")">
                                @(item.MienPhi ? "Miễn phí" : "Trả phí")
                            </span>
                        </td>
                        <td><i class="fas fa-eye text-muted me-1"></i> @(item.LuotXem ?? 0)</td>
                        <td>@(item.NgayPhatHanh?.ToString("dd/MM/yyyy HH:mm"))</td>
                        <td class="text-end">
                            <a href="/Truyen/Doc/@item.MaChuong" target="_blank" class="btn btn-sm btn-outline-info me-1">
                                <i class="fas fa-book-open"></i> Xem
                            </a>
                            <a href="/Admin/ChuongManagement/Edit/@item.MaChuong" class="btn btn-sm btn-outline-warning me-1">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                            <a href="/Admin/ChuongManagement/Delete/@item.MaChuong" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Truyện này chưa có chương nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
