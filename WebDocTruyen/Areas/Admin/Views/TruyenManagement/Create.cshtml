@model WebDocTruyen.Models.Truyen

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm Truyện Mới";
}

<div class="card shadow-sm border-0 rounded-4 p-4 bg-white max-w-800 mx-auto">
    <h3 class="mb-4 text-primary"><i class="fas fa-book-medical me-2"></i> Thêm Truyện Mới</h3>

    <!-- Bắt buộc phải có enctype="multipart/form-data" để upload được file -->
    <form asp-area="Admin" asp-controller="TruyenManagement" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TenTruyen" class="form-label fw-bold">Tên Truyện</label>
            <input asp-for="TenTruyen" class="form-control" placeholder="Nhập tên truyện..." />
            <span asp-validation-for="TenTruyen" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TacGia" class="form-label fw-bold">Tác Giả</label>
            <input asp-for="TacGia" class="form-control" placeholder="Tên tác giả..." />
        </div>

        <!-- Ô chọn file ảnh từ máy tính -->
        <div class="mb-3">
            <label class="form-label fw-bold">Ảnh Bìa (Chọn file từ máy)</label>
            <input type="file" name="file" class="form-control" accept="image/*" />
        </div>

        <div class="mb-3">
            <label asp-for="MoTa" class="form-label fw-bold">Mô Tả / Nội Dung Giới Thiệu</label>
            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="TrangThai" class="form-label fw-bold">Trạng Thái</label>
            <select asp-for="TrangThai" class="form-control">
                <option value="Đang tiến hành">Đang tiến hành</option>
                <option value="Hoàn thành">Hoàn thành</option>
            </select>
        </div>

        <!-- THIẾT LẬP CHÍNH SÁCH GIÁ BÁN LẺ (US08 / US15) -->
        <div class="card p-3 mb-3 bg-light border">
            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-tag text-warning me-1"></i> Thiết Lập Chính Sách Giá Truyện</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ChinhSachTruyCap" class="form-label fw-bold">Chính Sách Truy Cập</label>
                    <select asp-for="ChinhSachTruyCap" class="form-control" id="selectChinhSach">
                        <option value="Free">Miễn phí (Free)</option>
                        <option value="Paid">Trả phí mua lẻ (Paid)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="GiaBan" class="form-label fw-bold">Giá Bán Lẻ (VNĐ)</label>
                    <input asp-for="GiaBan" type="number" step="1000" min="0" class="form-control" id="inputGiaBan" placeholder="Ví dụ: 49000" value="0" />
                    <small class="text-muted">Nhập số tiền bán trọn bộ truyện (nếu là Trả phí)</small>
                </div>
            </div>
        </div>

        <!-- PHẦN CHỌN THỂ LOẠI -->
        <div class="mb-3">
            <label class="form-label fw-bold">Thể Loại Truyện</label>
            <div class="row border rounded-3 p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                @if (ViewBag.TheLoaiList != null)
                {
                    foreach (var item in ViewBag.TheLoaiList as List<WebDocTruyen.Models.TheLoai>)
                    {
                        <div class="col-md-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedTheLoais" value="@item.MaTheLoai" id="tl_@item.MaTheLoai">
                                <label class="form-check-label" for="tl_@item.MaTheLoai">
                                    @item.TenTheLoai
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i> Lưu Lại</button>
            <a href="/Admin/TruyenManagement/Index" class="btn btn-secondary">Quay Lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('selectChinhSach').addEventListener('change', function () {
            const giaInput = document.getElementById('inputGiaBan');
            if (this.value === 'Paid') {
                if (parseFloat(giaInput.value) <= 0) giaInput.value = 49000;
            } else {
                giaInput.value = 0;
            }
        });
    </script>
}