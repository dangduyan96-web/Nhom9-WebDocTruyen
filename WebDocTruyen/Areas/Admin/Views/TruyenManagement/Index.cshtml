@model IEnumerable<WebDocTruyen.Models.Truyen>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản Lý Truyện";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📚 Quản Lý Danh Sách Truyện</h2>
    <!-- Dùng href trực tiếp tuyệt đối vào Area Admin -->
    <a href="/Admin/TruyenManagement/Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Thêm Truyện Mới
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 p-3 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh Bìa</th>
                    <th>Tên Truyện</th>
                    <th>Tác Giả</th>
                    <th>Lượt Xem</th>
                    <th>Trạng Thái</th>
                    <th class="text-end">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.AnhBia" alt="" style="width: 45px; height: 60px; object-fit: contain; border-radius: 4px;" />
                        </td>
                        <td class="fw-bold">@item.TenTruyen</td>
                        <td>@(string.IsNullOrEmpty(item.TacGia) ? "Đang cập nhật" : item.TacGia)</td>
                        <td><i class="fas fa-eye text-muted me-1"></i> @(item.LuotXem ?? 0)</td>
                        <td>
                            <span class="badge @(item.TrangThai == "Hoàn thành" ? "bg-success" : "bg-warning text-dark")">
                                @item.TrangThai
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="/Admin/ChuongManagement/Index?maTruyen=@item.MaTruyen" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fas fa-list"></i> Chương
                            </a>
                            <!-- Nút Sửa dùng href trực tiếp -->
                            <a href="/Admin/TruyenManagement/Edit/@item.MaTruyen" class="btn btn-sm btn-outline-warning me-1">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                            <!-- Nút Xóa dùng href trực tiếp -->
                            <a href="/Admin/TruyenManagement/Delete/@item.MaTruyen" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>