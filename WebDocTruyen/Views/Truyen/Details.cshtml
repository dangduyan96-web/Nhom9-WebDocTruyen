@model WebDocTruyen.ViewModels.TruyenDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var t = Model.Truyen;
    ViewData["Title"] = t.TenTruyen;
    var chuongDau = Model.Chuongs.FirstOrDefault();
}

@section styles {
    <style>
        .detail-cover {
            width: 100%;
            max-width: 240px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,.15);
        }

        .detail-title {
            font-size: 28px;
            font-weight: 800;
        }

        .genre-pill {
            display: inline-block;
            background: #fef2f2;
            color: #e8392a;
            border-radius: 999px;
            padding: 3px 12px;
            font-size: 12px;
            font-weight: 600;
            margin: 0 6px 6px 0;
        }

        .stat-box {
            background: #fff;
            border: 1px solid #f1f5f9;
            border-radius: 12px;
            padding: 10px 16px;
            text-align: center;
            min-width: 100px;
        }

            .stat-box strong {
                display: block;
                font-size: 18px;
            }

        .chapter-list {
            max-height: 520px;
            overflow-y: auto;
        }

        .chapter-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 14px;
            border-bottom: 1px solid #f1f5f9;
            text-decoration: none;
            color: #1e293b;
        }

            .chapter-item:hover {
                background: #fafafa;
                color: #e8392a;
            }

            .chapter-item.locked {
                color: #9ca3af;
                cursor: not-allowed;
            }

        .pricing-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fffbeb;
            color: #b45309;
            border: 1px solid #fde68a;
            border-radius: 999px;
            padding: 4px 14px;
            font-size: 13px;
            font-weight: 700;
        }

        .purchased-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
            border-radius: 999px;
            padding: 4px 14px;
            font-size: 13px;
            font-weight: 700;
        }
    </style>
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Ảnh bìa -->
        <div class="col-md-3 text-center">
            <img class="detail-cover" src="@(t.AnhBia ?? "/images/default-cover.jpg")" alt="@t.TenTruyen" />
        </div>

        <!-- Thông tin -->
        <div class="col-md-9">
            <h1 class="detail-title">@t.TenTruyen</h1>
            <p class="text-muted mb-2">Tác giả: <strong>@(string.IsNullOrEmpty(t.TacGia) ? "Đang cập nhật" : t.TacGia)</strong></p>

            <div class="mb-3">
                @foreach (var tl in Model.TheLoais)
                {
                    <span class="genre-pill">@tl</span>
                }
                <span class="genre-pill" style="background:#ecfdf5;color:#196f5b">@t.TrangThai</span>
                @if (t.ChinhSachTruyCap == "Paid" || (t.GiaBan ?? 0) > 0)
                {
                    @if (Model.DaMuaLe)
                    {
                        <span class="purchased-badge"><i class="fas fa-check-circle"></i> Đã sở hữu truyện</span>
                    }
                    else
                    {
                        var giaHienThi = (t.GiaBan ?? 0) > 0 ? t.GiaBan!.Value : 49000;
                        <span class="pricing-badge"><i class="fas fa-gem"></i> Giá lẻ: @giaHienThi.ToString("N0") đ</span>
                    }
                }
            </div>

            <div class="d-flex flex-wrap gap-3 mb-3">
                <div class="stat-box"><strong>@(t.LuotXem ?? 0)</strong><small>Lượt xem</small></div>
                <div class="stat-box"><strong id="likeCount">@(t.LuotThich ?? 0)</strong><small>Lượt thích</small></div>
                <div class="stat-box"><strong>@Model.Chuongs.Count</strong><small>Chương</small></div>
                <div class="stat-box">
                    <strong>@(Model.SoDanhGia > 0 ? Model.DiemTrungBinh.ToString("0.0") : "–") ★</strong>
                    <small>@Model.SoDanhGia đánh giá</small>
                </div>
            </div>

            <!-- Thông báo TempData -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Nút hành động -->
            <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                @if (chuongDau != null)
                {
                    var chuongDoc = Model.MaChuongDangDoc ?? chuongDau.MaChuong;
                    <a class="btn btn-danger rounded-pill px-4" href="/Truyen/Doc/@chuongDoc">
                        <i class="fas fa-book-reader me-1"></i> @(Model.MaChuongDangDoc.HasValue ? "Đọc tiếp" : "Đọc từ đầu")
                    </a>
                }

                @if ((t.ChinhSachTruyCap == "Paid" || (t.GiaBan ?? 0) > 0) && !Model.DaMuaLe)
                {
                    var giaBan = (t.GiaBan ?? 0) > 0 ? t.GiaBan!.Value : 49000;
                    <button type="button" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm"
                            data-bs-toggle="modal" data-bs-target="#modalMuaTruyen">
                        <i class="fas fa-shopping-cart me-1"></i> Mua trọn bộ (@giaBan.ToString("N0") đ)
                    </button>
                }

                <form id="favForm" method="post" class="d-inline">@Html.AntiForgeryToken()</form>
                <button type="button" id="btnYeuThich"
                        data-id="@t.MaTruyen"
                        data-login="@(Model.DaDangNhap ? "1" : "0")"
                        class="btn @(Model.DaYeuThich ? "btn-danger" : "btn-outline-danger") rounded-pill px-4">
                    <i class="fas fa-heart me-1"></i> <span id="btnYeuThichText">@(Model.DaYeuThich ? "Đã yêu thích" : "Yêu thích")</span>
                </button>

                <!-- Nút cuộn xuống phần bình luận -->
                @if (chuongDau != null)
                {
                    <a href="#khu-vuc-binh-luan" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="fas fa-comments me-1"></i> Bình luận
                    </a>
                }

                <!-- Nút Đánh giá truyện -->
                <button type="button" class="btn btn-outline-warning text-dark rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                    <i class="fas fa-star text-warning me-1"></i> @(ViewBag.DanhGiaCuaToi != null ? "Sửa đánh giá" : "Đánh giá") (@(Model.SoDanhGia > 0 ? Model.DiemTrungBinh.ToString("0.0") : "0") ★)
                </button>
            </div>

            <h5 class="fw-bold">Giới thiệu</h5>
            <p style="white-space: pre-line">@(string.IsNullOrWhiteSpace(t.MoTa) ? "Chưa có mô tả." : t.MoTa)</p>
        </div>
    </div>

    <!-- Danh sách chương -->
    <h4 class="fw-bold mt-5 mb-3">Danh sách chương</h4>
    @if (!Model.Chuongs.Any())
    {
        <p class="text-muted">Truyện chưa có chương nào.</p>
    }
    else
    {
        <div class="chapter-list card border-0 shadow-sm">
            @foreach (var c in Model.Chuongs)
            {
                bool duocDoc = c.MienPhi || Model.CoQuyenDoc;
                if (duocDoc)
                {
                    <a class="chapter-item" href="/Truyen/Doc/@c.MaChuong">
                        <span>Chương @c.SoThuTuChuong: @c.TieuDe</span>
                        <small class="text-muted">@c.NgayPhatHanh?.ToString("dd/MM/yyyy")</small>
                    </a>
                }
                else
                {
                    <div class="chapter-item locked" title="Chương trả phí">
                        <span>Chương @c.SoThuTuChuong: @c.TieuDe</span>
                        <i class="fas fa-lock"></i>
                    </div>
                }
            }
        </div>
    }

    <!-- KHU VỰC THẢO LUẬN VÀ BÌNH LUẬN -->
    <div id="khu-vuc-binh-luan" class="discussion-section mt-5 mb-5">
        <h4 class="fw-bold mb-3"><i class="fas fa-comments text-primary me-2"></i> Thảo luận và bình luận</h4>

        <!-- Form gửi bình luận -->
        @if (!Model.DaDangNhap)
        {
            <div class="alert alert-info d-flex align-items-center justify-content-between shadow-sm">
                <span>Bạn cần đăng nhập để tham gia thảo luận và bình luận truyện.</span>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3 rounded-pill">Đăng nhập ngay</a>
            </div>
        }
        else if (Model.Chuongs != null && Model.Chuongs.Count > 0)
        {
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <form asp-controller="Truyen" asp-action="ThemBinhLuan" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maTruyen" value="@Model.Truyen.MaTruyen" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Chọn chương thảo luận:</label>
                            <select name="maChuong" class="form-select bg-light" style="max-width: 400px;" required>
                                @foreach (var chuong in Model.Chuongs)
                                {
                                    <option value="@chuong.MaChuong">Chương @chuong.SoThuTuChuong: @chuong.TieuDe</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <textarea name="noiDung" class="form-control bg-light" rows="3" maxlength="2000" placeholder="Viết cảm nghĩ của bạn về truyện hoặc chương này (tối đa 2000 ký tự)..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary px-4 rounded-pill">
                            <i class="fas fa-paper-plane me-1"></i> Gửi bình luận
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Truyện hiện chưa có chương nào để thảo luận.</div>
        }

        <!-- Danh sách bình luận -->
        <div class="danh-sach-binh-luan">
            @{
                var listBinhLuan = ViewBag.DanhSachBinhLuan as List<WebDocTruyen.Models.BinhLuanChuong>;
                var vaiTro = Context.Session.GetString("VaiTro") ?? "";
                bool laAdmin = vaiTro.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
                               vaiTro.Equals("Quản trị viên", StringComparison.OrdinalIgnoreCase) ||
                               vaiTro.Equals("Quan tri vien", StringComparison.OrdinalIgnoreCase);
            }

            @if (listBinhLuan != null && listBinhLuan.Count > 0)
            {
                <p class="text-muted fw-semibold mb-3">Có @listBinhLuan.Count bình luận</p>

                foreach (var bl in listBinhLuan)
                {
                    var tenHienThi = string.IsNullOrEmpty(bl.MaNguoiDungNavigation?.HoTen)
                        ? bl.MaNguoiDungNavigation?.TenDangNhap
                        : bl.MaNguoiDungNavigation.HoTen;

                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(bl.MaNguoiDungNavigation?.AnhDaiDien))
                                    {
                                        <img src="@bl.MaNguoiDungNavigation.AnhDaiDien" alt="Avatar" class="rounded-circle me-2" style="width: 36px; height: 36px; object-fit: cover; border: 1px solid #ddd;" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle fa-2x text-secondary me-2"></i>
                                    }
                                    <strong class="text-dark">@tenHienThi</strong>
                                    <span class="badge bg-secondary ms-2 rounded-pill">
                                        Chương @bl.MaChuongNavigation?.SoThuTuChuong
                                    </span>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted">
                                        @(bl.NgayTao?.ToString("dd/MM/yyyy HH:mm"))
                                    </small>

                                    <!-- Nút ẩn bình luận dành riêng cho Admin -->
                                    @if (laAdmin)
                                    {
                                        <form asp-controller="Truyen" asp-action="AnBinhLuan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn ẩn bình luận này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@bl.MaBinhLuan" />
                                            <input type="hidden" name="maTruyen" value="@Model.Truyen.MaTruyen" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Ẩn bình luận vi phạm">
                                                <i class="fas fa-eye-slash"></i> Ẩn
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <p class="mb-0 text-dark" style="white-space: pre-line; margin-left: 44px;">@bl.NoiDung</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="far fa-comment-dots fa-3x mb-3 text-secondary"></i>
                    <p class="mb-0">Chưa có bình luận nào. Hãy là người đầu tiên bình luận!</p>
                </div>
            }
        </div>
    </div>

    <!-- KHU VỰC ĐÁNH GIÁ TRUYỆN -->
    @{
        var listDanhGia = ViewBag.DanhSachDanhGia as List<WebDocTruyen.Models.DanhGiaTruyen>;
        var myRating = ViewBag.DanhGiaCuaToi as WebDocTruyen.Models.DanhGiaTruyen;
    }
    <div id="khu-vuc-danh-gia" class="rating-section mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">
                <i class="fas fa-star text-warning me-2"></i>Đánh giá từ độc giả
                <span class="fs-6 text-muted fw-normal">(@(listDanhGia?.Count ?? 0) lượt đánh giá)</span>
            </h4>
            <button type="button" class="btn btn-warning rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                <i class="fas fa-pen me-1"></i> @(myRating != null ? "Cập nhật đánh giá" : "Viết đánh giá")
            </button>
        </div>

        @if (listDanhGia != null && listDanhGia.Count > 0)
        {
            <div class="row g-3">
                @foreach (var dg in listDanhGia)
                {
                    var tenUser = string.IsNullOrEmpty(dg.MaNguoiDungNavigation?.HoTen)
                        ? dg.MaNguoiDungNavigation?.TenDangNhap
                        : dg.MaNguoiDungNavigation.HoTen;

                    <div class="col-md-6">
                        <div class="card h-100 border-0 shadow-sm p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(dg.MaNguoiDungNavigation?.AnhDaiDien))
                                    {
                                        <img src="@dg.MaNguoiDungNavigation.AnhDaiDien" alt="" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle fa-2x text-muted"></i>
                                    }
                                    <div>
                                        <strong class="d-block text-dark">@tenUser</strong>
                                        <small class="text-muted">@dg.NgayTao?.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= (dg.SoSao ?? 0) ? "text-warning" : "text-secondary opacity-25")"></i>
                                    }
                                </div>
                            </div>
                            <p class="mb-0 text-secondary small">@(string.IsNullOrEmpty(dg.NoiDungDanhGia) ? "Không có lời nhận xét." : dg.NoiDungDanhGia)</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm p-4 text-center text-muted">
                <p class="mb-2"><i class="far fa-star fa-2x text-warning opacity-50"></i></p>
                <p class="mb-0">Truyện chưa có lượt đánh giá nào. Hãy là người đầu tiên đánh giá bộ truyện này!</p>
            </div>
        }
    </div>
</div>

<!-- MODAL ĐÁNH GIÁ TRUYỆN -->
<div class="modal fade" id="modalDanhGia" tabindex="-1" aria-labelledby="modalDanhGiaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="modalDanhGiaLabel">
                    <i class="fas fa-star me-2"></i>Đánh giá truyện: @Model.Truyen.TenTruyen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @if (!Model.DaDangNhap)
            {
                <div class="modal-body text-center p-4">
                    <i class="fas fa-user-lock fa-3x text-warning mb-3"></i>
                    <h5>Bạn chưa đăng nhập</h5>
                    <p class="text-muted">Vui lòng đăng nhập để gửi đánh giá và nhận xét truyện.</p>
                    <a href="/Account/Login?returnUrl=@Url.Action("Details", "Truyen", new { id = Model.Truyen.MaTruyen })" class="btn btn-primary px-4 rounded-pill">
                        Đăng nhập ngay
                    </a>
                </div>
            }
            else
            {
                <form asp-controller="Truyen" asp-action="GuiDanhGia" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maTruyen" value="@Model.Truyen.MaTruyen" />

                    <div class="modal-body p-4">
                        <div class="mb-3 text-center">
                            <label class="form-label fw-bold d-block mb-2">Chọn số sao đánh giá</label>
                            <div class="star-rating d-inline-flex gap-2 fs-3">
                                @{
                                    int currentStar = myRating?.SoSao ?? 5;
                                }
                                <select name="soSao" class="form-select text-center fw-bold fs-5 text-warning bg-light" style="max-width: 200px; margin: 0 auto;" required>
                                    <option value="5" selected="@(currentStar == 5)">⭐⭐⭐⭐⭐ (5 sao - Tuyệt vời)</option>
                                    <option value="4" selected="@(currentStar == 4)">⭐⭐⭐⭐ (4 sao - Rất hay)</option>
                                    <option value="3" selected="@(currentStar == 3)">⭐⭐⭐ (3 sao - Bình thường)</option>
                                    <option value="2" selected="@(currentStar == 2)">⭐⭐ (2 sao - Tạm được)</option>
                                    <option value="1" selected="@(currentStar == 1)">⭐ (1 sao - Dở)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nhận xét của bạn</label>
                            <textarea name="noiDungDanhGia" class="form-control" rows="4" maxlength="2000" placeholder="Cảm nhận chi tiết của bạn về cốt truyện, nhân vật, văn phong..." required>@(myRating?.NoiDungDanhGia ?? "")</textarea>
                            <small class="text-muted">Tối đa 2000 ký tự.</small>
                        </div>
                    </div>

                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">
                            <i class="fas fa-paper-plane me-1"></i> @(myRating != null ? "Cập nhật đánh giá" : "Gửi đánh giá")
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@if ((t.ChinhSachTruyCap == "Paid" || (t.GiaBan ?? 0) > 0) && !Model.DaMuaLe)
{
    var giaMua = (t.GiaBan ?? 0) > 0 ? t.GiaBan!.Value : 49000;
    <!-- Modal Xác nhận mua truyện (US08) -->
    <div class="modal fade" id="modalMuaTruyen" tabindex="-1" aria-labelledby="modalMuaTruyenLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalMuaTruyenLabel">
                        <i class="fas fa-shopping-cart me-2"></i>Xác nhận mua trọn bộ truyện
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="MuaTruyen" asp-controller="Truyen" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@t.MaTruyen" />
                    <div class="modal-body p-4">
                        @if (!Model.DaDangNhap)
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-user-lock fa-3x text-warning mb-3"></i>
                                <h5>Bạn chưa đăng nhập</h5>
                                <p class="text-muted">Vui lòng đăng nhập tài khoản để thực hiện giao dịch mua truyện.</p>
                                <a href="/Account/Login?returnUrl=@Url.Action("Details", "Truyen", new { id = t.MaTruyen })"
                                   class="btn btn-danger px-4 rounded-pill">
                                    Đăng nhập ngay
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded">
                                <img src="@(t.AnhBia ?? "/images/default-cover.jpg")" alt="@t.TenTruyen"
                                     style="width: 60px; height: 85px; object-fit: cover; border-radius: 6px;" />
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@t.TenTruyen</h6>
                                    <small class="text-muted d-block">Tác giả: @(string.IsNullOrEmpty(t.TacGia) ? "Đang cập nhật" : t.TacGia)</small>
                                    <small class="text-muted d-block">Tổng số: <strong>@Model.Chuongs.Count</strong> chương</small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <span class="text-muted">Giá trọn bộ:</span>
                                <span class="fs-4 fw-bold text-danger">@giaMua.ToString("N0") đ</span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted text-uppercase">Chọn phương thức thanh toán</label>
                                <div class="list-group">
                                    <label class="list-group-item d-flex align-items-center gap-3 cursor-pointer py-3">
                                        <input class="form-check-input me-1" type="radio" name="phuongThuc" value="VNPAY" checked>
                                        <div class="d-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-3 p-2" style="width: 44px; height: 44px;">
                                            <i class="fas fa-qrcode fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                <span>Cổng VNPAY / QR Code</span>
                                                <span class="badge bg-danger rounded-pill" style="font-size: 10px;">Phổ biến</span>
                                            </div>
                                            <small class="text-muted">Quét mã QR qua ứng dụng ngân hàng hoặc ví VNPAY</small>
                                        </div>
                                    </label>
                                    <label class="list-group-item d-flex align-items-center gap-3 cursor-pointer py-3">
                                        <input class="form-check-input me-1" type="radio" name="phuongThuc" value="PayPal">
                                        <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 p-2" style="width: 44px; height: 44px;">
                                            <i class="fab fa-paypal fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                                <span>PayPal</span>
                                                <span class="badge bg-primary rounded-pill" style="font-size: 10px;">Quốc tế</span>
                                            </div>
                                            <small class="text-muted">Thanh toán an toàn qua tài khoản PayPal hoặc thẻ quốc tế</small>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <div class="alert alert-secondary small mb-0 py-2">
                                <i class="fas fa-shield-alt text-success me-1"></i> Sau khi xác nhận, bạn sẽ sở hữu vĩnh viễn toàn bộ các chương trả phí của bộ truyện này.
                            </div>
                        }
                    </div>
                    @if (Model.DaDangNhap)
                    {
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                <i class="fas fa-lock me-1"></i> Thanh toán ngay
                            </button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
}

@section scripts {
    <script>
        (function () {
            const btn = document.getElementById('btnYeuThich');
            if (!btn) return;

            btn.addEventListener('click', async function () {
                // Chưa đăng nhập -> chuyển sang trang đăng nhập
                if (btn.dataset.login !== '1') {
                    window.location.href = '/Account/Login';
                    return;
                }

                btn.disabled = true;
                try {
                    const token = document.querySelector('#favForm input[name="__RequestVerificationToken"]').value;
                    const res = await fetch('/Truyen/ToggleYeuThich/' + btn.dataset.id, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: '__RequestVerificationToken=' + encodeURIComponent(token)
                    });

                    if (res.status === 401) {
                        window.location.href = '/Account/Login';
                        return;
                    }
                    if (!res.ok) throw new Error('HTTP ' + res.status);

                    const data = await res.json();
                    btn.classList.toggle('btn-danger', data.daYeuThich);
                    btn.classList.toggle('btn-outline-danger', !data.daYeuThich);
                    document.getElementById('btnYeuThichText').textContent = data.daYeuThich ? 'Đã yêu thích' : 'Yêu thích';
                    document.getElementById('likeCount').textContent = data.luotThich;
                } catch (e) {
                    alert('Có lỗi xảy ra, vui lòng thử lại.');
                } finally {
                    btn.disabled = false;
                }
            });
        })();
    </script>
}
