                            <div class="hot-book-card-item">
                                <span class="hot-tag-badge">HOT</span>
                                <a href="@Url.Action("Details", "Truyen", new { id = hotItem.MaTruyen })" class="hot-cover-wrap">
                                    <img src="@(string.IsNullOrEmpty(hotItem.AnhBia) ? "https://via.placeholder.com/300x420?text=No+Cover" : hotItem.AnhBia)"
                                         alt="@hotItem.TenTruyen"
                                         loading="lazy"
                                         onerror="this.src='https://via.placeholder.com/300x420?text=No+Cover';" />
                                </a>
                                <div class="hot-info-meta">
                                    <h4 class="hot-book-title">
                                        <a href="@Url.Action("Details", "Truyen", new { id = hotItem.MaTruyen })" title="@hotItem.TenTruyen">
