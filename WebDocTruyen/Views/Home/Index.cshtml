    <!-- 5. DÀNH CHO BẠN (Gợi ý AJAX) -->
    <div class="section-header-modern mt-5">
        <h2 class="section-header-title">Dành Cho Bạn</h2>
    </div>

    <div id="recommend-area" class="books-cards-grid">
        <!-- AJAX nạp truyện gợi ý -->
    </div>

    <div class="more-wrap-dark">
        <a href="@Url.Action("Category", "Home")" class="btn-see-more-dark">
            <i class="fas fa-th-large"></i> Khám phá tất cả truyện
        </a>
