@using WebDocTruyen.Models
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang Chủ - Web Đọc Truyện Online";
    var user = HttpContextAccessor.HttpContext?.Session.GetString("TaiKhoan");
}

@model List<WebDocTruyen.Models.Truyen>

@section styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        
        /* Hero Slideshow */
        .hero-section {
            padding: 24px 0 0;
        }

        .hero-slide-wrapper {
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(0,0,0,.1);
            position: relative;
            background: #1e293b;
            cursor: pointer;
        }

        .slide-track {
            display: flex;
            transition: transform .55s cubic-bezier(.4,0,.2,1);
        }

            .slide-track img {
                width: 100%;
                flex-shrink: 0;
                height: 320px;
                display: block;
                object-fit: cover;
            }

        .slide-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255,255,255,.92);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #1e293b;
            box-shadow: 0 4px 16px rgba(0,0,0,.12);
            transition: .25s;
            z-index: 10;
        }

            .slide-arrow:hover {
                background: #e8392a;
                color: #fff;
            }

        .slide-prev {
            left: 14px;
        }

        .slide-next {
            right: 14px;
        }

        .slide-dots {
            position: absolute;
            bottom: 14px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 7px;
        }

        .slide-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255,255,255,.55);
            border: none;
            cursor: pointer;
            transition: .25s;
        }

            .slide-dot.active {
                background: #fff;
                width: 24px;
                border-radius: 4px;
            }

        /* Feature badges */
        .features-bar {
            display: flex;
            gap: 16px;
            margin: 20px 0 32px;
            flex-wrap: wrap;
        }

        .feature-item {
            flex: 1;
            min-width: 160px;
            background: #fff;
            border-radius: 14px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,.05);
            border: 1px solid #f1f5f9;
        }

        .feature-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #fef2f2;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #e8392a;
            flex-shrink: 0;
        }

        .feature-text strong {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: #111827;
        }

        .feature-text span {
            font-size: 12px;
            color: #9ca3af;
        }

        /* Section heading */
        .section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 36px 0 20px;
        }

            .section-head h2 {
                font-size: 22px;
                font-weight: 800;
                color: #111827;
                position: relative;
                padding-bottom: 10px;
                margin: 0;
            }

                .section-head h2::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 44px;
                    height: 3.5px;
                    background: linear-gradient(135deg,#e8392a,#ff6b5b);
                    border-radius: 2px;
                }

        .see-all-link {
            color: #e8392a;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: .2s;
            text-decoration: none;
        }

            .see-all-link:hover {
                gap: 8px;
                color: #c0281c;
                text-decoration: none;
            }

        /* Top 5 truyện hot */
        .top-books-title {
            font-size: 24px;
            font-weight: 800;
            color: #111827;
            text-align: center;
            margin: 50px 0 32px 0;
        }

        .champion-book-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            border: 1px solid #e5e7eb;
            padding: 30px;
            max-width: 500px;
            margin: 0 auto 40px auto;
            text-align: center;
            position: relative;
        }

        .champion-badge {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            color: #fff;
            font-weight: 800;
            font-size: 12px;
            text-transform: uppercase;
            padding: 6px 16px;
            border-radius: 999px;
            box-shadow: 0 4px 12px rgba(245,158,11,0.3);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .champion-book-card img {
            max-height: 220px;
            object-fit: contain;
            margin: 10px auto 20px auto;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            border-radius: 8px;
        }

        .champion-book-card h3 {
            font-size: 18px;
            font-weight: 800;
            color: #111827;
            margin-bottom: 6px;
        }

        .champion-book-card .author {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 10px;
        }

        .champion-book-card .stats-info {
            font-size: 14px;
            font-weight: 700;
            color: #e8392a;
            margin-bottom: 0;
        }

        .sub-book-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
            border: 1px solid #e5e7eb;
            padding: 20px;
            text-align: center;
            height: 100%;
            transition: transform 0.25s;
        }

            .sub-book-card:hover {
                transform: translateY(-4px);
            }

            .sub-book-card img {
                height: 140px;
                object-fit: contain;
                margin: 0 auto 16px auto;
                box-shadow: 0 4px 10px rgba(0,0,0,0.06);
                border-radius: 6px;
            }

            .sub-book-card h4 {
                font-size: 14px;
                font-weight: 700;
                color: #111827;
                line-height: 1.4;
                margin-bottom: 6px;
                height: 38px;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .sub-book-card .author {
                font-size: 12px;
                color: #6b7280;
                margin-bottom: 8px;
            }

            .sub-book-card .stats-info {
                font-size: 13px;
                font-weight: 700;
                color: #e8392a;
                margin: 0;
            }

        /* Product grid & Card */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        @@media(max-width:991px) {
            .products-grid {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media(max-width:767px) {
            .products-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:480px) {
            .products-grid {
                grid-template-columns: 1fr;
            }
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 14px rgba(0,0,0,.06);
            border: 1px solid #f1f5f9;
            transition: .3s;
            display: flex;
            flex-direction: column;
            position: relative;
        }

            .product-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 36px rgba(0,0,0,.12);
            }

        .product-img-wrap {
            background: #fafafa;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 210px;
            overflow: hidden;
            padding: 12px;
        }

            .product-img-wrap img {
                max-height: 186px;
                width: auto;
                object-fit: contain;
                transition: transform .4s ease;
            }

        .product-card:hover .product-img-wrap img {
            transform: scale(1.06);
        }

        .product-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(232, 57, 42, 0.9);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 5px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .product-body {
            padding: 14px 14px 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .product-title {
            font-size: 14px;
            font-weight: 600;
            color: #1e293b;
            line-height: 1.4;
            margin-bottom: 8px;
            height: 40px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

            .product-title a {
                color: inherit;
                text-decoration: none;
            }

                .product-title a:hover {
                    color: #e8392a;
                }

        .meta-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: #64748b;
            margin-bottom: 10px;
        }

        .btn-buy-card {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 38px;
            border-radius: 999px;
            background: linear-gradient(135deg,#e8392a,#ff6b5b);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            margin-top: auto;
            text-decoration: none;
            transition: .25s;
            box-shadow: 0 4px 12px rgba(232,57,42,.2);
        }

            .btn-buy-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(232,57,42,.3);
                color: #fff;
                text-decoration: none;
            }

        .more-wrap {
            display: flex;
            justify-content: center;
            margin: 36px 0 56px;
        }

        .btn-see-more {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 32px;
            height: 46px;
            border-radius: 999px;
            border: 1.5px solid #e8392a;
            color: #e8392a;
            background: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: .25s;
            text-decoration: none;
        }

            .btn-see-more:hover {
                background: linear-gradient(135deg,#e8392a,#ff6b5b);
                color: #fff !important;
                border-color: transparent;
                box-shadow: 0 6px 20px rgba(232,57,42,.25);
                transform: translateY(-2px);
                text-decoration: none;
            }
    </style>
}

<div class="container hero-section">
    <!-- Banner Slideshow -->
    <div class="hero-slide-wrapper" id="heroSlider">
        <div class="slide-track" id="slideTrack">
            <img src="~/Images/banner1.jpg" alt="Slide 1">
            <img src="~/Images/banner2.jpg" alt="Slide 2">
            <img src="~/Images/banner3.jpg" alt="Slide 3">
        </div>
        <button class="slide-arrow slide-prev" id="slidePrev"><i class="fas fa-chevron-left"></i></button>
        <button class="slide-arrow slide-next" id="slideNext"><i class="fas fa-chevron-right"></i></button>
        <div class="slide-dots" id="slideDots"></div>
    </div>

    <!-- Features Bar -->
    <div class="features-bar">
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-book-open"></i></div>
            <div class="feature-text">
                <strong>Kho truyện đồ sộ</strong>
                <span>Cập nhật liên tục</span>
            </div>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-bolt"></i></div>
            <div class="feature-text">
                <strong>Đọc siêu tốc</strong>
                <span>Tốc độ tải nhanh</span>
            </div>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-mobile-alt"></i></div>
            <div class="feature-text">
                <strong>Tương thích tốt</strong>
                <span>Mọi thiết bị</span>
            </div>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-heart"></i></div>
            <div class="feature-text">
                <strong>Miễn phí 100%</strong>
                <span>Đọc mọi lúc mọi nơi</span>
            </div>
        </div>
    </div>

    <!-- Top 5 Truyện Đọc Nhiều Nhất -->
    @if (Model != null && Model.Count > 0)
    {
        <h2 class="top-books-title"><i class="bi bi-trophy-fill text-warning mr-2"></i> Top Truyện Đọc Nhiều Nhất</h2>

        <div class="champion-book-card">
            <span class="champion-badge"><i class="bi bi-award-fill"></i> Truyện HOT nhất</span>
            <a href="@Url.Action("Details", "Truyen", new { id = Model[0].MaTruyen })">
                <img src="@Model[0].AnhBia" alt="@Model[0].TenTruyen" />
            </a>
            <h3><a href="@Url.Action("Details", "Truyen", new { id = Model[0].MaTruyen })" class="text-dark">@Model[0].TenTruyen</a></h3>
            <p class="author">Tác giả: <strong>@(string.IsNullOrEmpty(Model[0].TacGia) ? "Đang cập nhật" : Model[0].TacGia)</strong></p>
            <p class="stats-info"><i class="fas fa-eye mr-1"></i> @(Model[0].LuotXem ?? 0) lượt xem</p>
        </div>

        <div class="row">
            @for (int i = 1; i < 5 && i < Model.Count; i++)
            {
                <div class="col-lg-3 col-md-6 col-sm-6 mb-4">
                    <div class="sub-book-card">
                        <a href="@Url.Action("Details", "Truyen", new { id = Model[i].MaTruyen })">
                            <img src="@Model[i].AnhBia" alt="@Model[i].TenTruyen" />
                        </a>
                        <h4><a href="@Url.Action("Details", "Truyen", new { id = Model[i].MaTruyen })" class="text-dark">@Model[i].TenTruyen</a></h4>
                        <p class="author">Tác giả: @(string.IsNullOrEmpty(Model[i].TacGia) ? "Đang cập nhật" : Model[i].TacGia)</p>
                        <p class="stats-info"><i class="fas fa-eye mr-1"></i> @(Model[i].LuotXem ?? 0) lượt xem</p>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Danh sách truyện / Bộ lọc -->
    <div class="section-head">
        <h2>📚 Truyện Mới Cập Nhật</h2>
        <a href="@Url.Action("Index", "Truyen")" class="see-all-link">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <!-- Thanh bộ lọc truyện -->
    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 18px; background: #fff; height: auto !important;">
        <form action="@Url.Action("Index", "Home")" method="get" class="row align-items-end">
            <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px;">Thể loại</label>
                @Html.DropDownList("maTheLoai", ViewBag.TheLoaiList as SelectList, "-- Tất cả thể loại --", new { @class = "form-control", @style = "border-radius: 8px; font-size: 14px; height: 42px;" })
            </div>
            <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px;">Trạng thái</label>
                <select name="trangThai" class="form-control" style="border-radius: 8px; font-size: 14px; height: 42px;">
                    <option value="">Tất cả trạng thái</option>
                    <option value="DangTienHanh" selected="@(ViewBag.TrangThai == "DangTienHanh")">Đang tiến hành</option>
                    <option value="HoanThanh" selected="@(ViewBag.TrangThai == "HoanThanh")">Hoàn thành</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6 mb-3 mb-md-0">
                <label style="font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px;">Sắp xếp theo</label>
                <select name="sortOrder" class="form-control" style="border-radius: 8px; font-size: 14px; height: 42px;">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SortOrder))">Mới cập nhật</option>
                    <option value="view_desc" selected="@(ViewBag.SortOrder == "view_desc")">Lượt xem: Nhiều nhất</option>
                    <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc")">Tên truyện: A - Z</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6 d-flex">
                <button type="submit" class="btn-buy-card border-0 w-100" style="height: 42px; border-radius: 8px; margin: 0; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fas fa-filter mr-1"></i> Lọc truyện
                </button>
                @if (ViewBag.MaTheLoai != null || !string.IsNullOrEmpty(ViewBag.TrangThai) || !string.IsNullOrEmpty(ViewBag.SortOrder))
                {
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="border-radius: 8px; font-size: 14px; font-weight: 700; height: 42px; width: 60px; border: 1.5px solid #cbd5e1; color: #475569; background: #fff; margin-left: 8px;">
                        <i class="fas fa-times"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 shadow-sm mb-5" style="background: #fff; border-radius: 16px; border: 1px solid #f1f5f9; padding: 40px 15px;">
            <i class="fas fa-search mb-3" style="font-size: 32px; color: #cbd5e1; display: block; margin: 0 auto 15px;"></i>
            <p style="color: #64748b; font-size: 15px; margin: 0;">Không tìm thấy bộ truyện nào khớp với bộ lọc của bạn.</p>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <span class="product-badge">@(item.TrangThai ?? "Đang tiến hành")</span>

                    <a href="@Url.Action("Details", "Truyen", new { id = item.MaTruyen })" class="product-img-wrap">
                        <img src="@item.AnhBia" alt="@item.TenTruyen" loading="lazy">
                    </a>

                    <div class="product-body">
                        <div class="product-title">
                            <a href="@Url.Action("Details", "Truyen", new { id = item.MaTruyen })">
                                @item.TenTruyen
                            </a>
                        </div>

                        <div class="meta-info">
                            <span><i class="fas fa-list-ol mr-1"></i> @(item.ChuongTruyens?.Count ?? 0) chương</span>
                            <span><i class="fas fa-eye mr-1"></i> @(item.LuotXem ?? 0)</span>
                        </div>

                        <a href="@Url.Action("Details", "Truyen", new { id = item.MaTruyen })" class="btn-buy-card mt-2">
                            <i class="fas fa-book-reader me-1"></i> Đọc ngay
                        </a>
                    </div>
                </div>
            }
        </div>
    }

    <!-- DÀNH CHO BẠN (Gợi ý AJAX) -->
    <div class="section-head mt-5">
        <h2>🎯 Dành Cho Bạn</h2>
    </div>

    <div id="recommend-area" class="products-grid">
        <!-- AJAX sẽ render truyện gợi ý vào đây -->
    </div>

    <div class="more-wrap">
        <a href="@Url.Action("Index", "Truyen")" class="btn-see-more">
            <i class="bi bi-grid"></i> Xem tất cả truyện
        </a>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            // AJAX Lấy danh sách truyện gợi ý
            $.get('@Url.Action("GetRecommend", "Home")', function (data) {
                let html = "";

                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        html += `
                            <div class="product-card">
                                <a href="/Truyen/Details/${item.maTruyen}" class="product-img-wrap">
                                    <img src="${item.anh}" alt="${item.tenTruyen}" loading="lazy">
                                </a>

                                <div class="product-body">
                                    <div class="product-title">
                                        <a href="/Truyen/Details/${item.maTruyen}">
                                            ${item.tenTruyen}
                                        </a>
                                    </div>

                                    <div class="meta-info">
                                        <span><i class="fas fa-eye mr-1"></i> ${item.luotXem || 0} lượt xem</span>
                                    </div>

                                    <a href="/Truyen/Details/${item.maTruyen}" class="btn-buy-card mt-2">
                                        <i class="fas fa-book-reader me-1"></i> Đọc ngay
                                    </a>
                                </div>
                            </div>`;
                    });
                    $("#recommend-area").html(html);
                }
            });

            // Slide Banner Logic
            const track = document.getElementById('slideTrack');
            const dotsWrap = document.getElementById('slideDots');
            const imgs = track.querySelectorAll('img');
            let cur = 0;
            const total = imgs.length;

            if (total > 0) {
                imgs.forEach((_, i) => {
                    const d = document.createElement('button');
                    d.className = 'slide-dot' + (i === 0 ? ' active' : '');
                    d.addEventListener('click', () => goTo(i));
                    dotsWrap.appendChild(d);
                });

                function goTo(n) {
                    cur = (n + total) % total;
                    track.style.transform = `translateX(-${cur * 100}%)`;
                    dotsWrap.querySelectorAll('.slide-dot').forEach((dot, idx) => {
                        dot.classList.toggle('active', idx === cur);
                    });
                }

                document.getElementById('slidePrev').addEventListener('click', () => goTo(cur - 1));
                document.getElementById('slideNext').addEventListener('click', () => goTo(cur + 1));

                // Tự động chuyển slide sau 5 giây
                setInterval(() => goTo(cur + 1), 5000);
            }
        });
    </script>
}