                        <i class="fas fa-check me-1"></i> @(item.TrangThai ?? "Đang tiến hành")
                    </span>

                    <a href="@Url.Action("Details", "Truyen", new { id = item.MaTruyen })" class="book-cover-anchor">
                        <img src="@item.AnhBia" alt="@item.TenTruyen" loading="lazy" onerror="this.src='https://via.placeholder.com/300x420?text=No+Cover';">
