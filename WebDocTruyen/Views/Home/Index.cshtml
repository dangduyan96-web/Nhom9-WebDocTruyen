<div class="home-main-container">
    <!-- 1. BANNER SLIDESHOW -->
    @{
        var activeBanners = _context.Banners
        .Where(b => b.HoatDong)
        .OrderBy(b => b.ThuTu)
        .ThenByDescending(b => b.MaBanner)
        .ToList();
    }

    <div class="hero-slide-wrapper" id="heroSlider">
        <div class="slide-track" id="slideTrack">
            @if (activeBanners.Any())
            {
                foreach (var b in activeBanners)
                {
                    var targetUrl = !string.IsNullOrWhiteSpace(b.LienKet) ? b.LienKet : "javascript:void(0)";
                    <a href="@targetUrl" class="hero-slide-item" title="@b.TieuDe">
                        <img src="@b.DuongDanAnh" alt="@b.TieuDe" onerror="this.src='/Images/banner1.jpg';" />
                    </a>
                }
            }
            else
            {
                <a href="javascript:void(0)" class="hero-slide-item">
                    <img src="~/Images/banner1.jpg" alt="Slide 1">
                </a>
                <a href="javascript:void(0)" class="hero-slide-item">
                    <img src="~/Images/banner2.jpg" alt="Slide 2">
                </a>
                <a href="javascript:void(0)" class="hero-slide-item">
                    <img src="~/Images/banner3.jpg" alt="Slide 3">
                </a>
            }
