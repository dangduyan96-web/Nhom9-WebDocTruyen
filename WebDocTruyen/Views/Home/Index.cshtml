</div>

@section scripts {
    <script>
        $(function () {
            // AJAX Lấy danh sách truyện gợi ý
            $.get('@Url.Action("GetRecommend", "Home")', function (data) {
                let html = "";
                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        html += `
                            <div class="modern-book-card">
                                <a href="/Truyen/Details/${item.maTruyen}" class="book-cover-anchor">
                                    <img src="${item.anh}" alt="${item.tenTruyen}" loading="lazy" onerror="this.src='https://via.placeholder.com/300x420?text=No+Cover';">
                                </a>

                                <div class="book-info-box">
                                    <h3 class="book-title-heading">
                                        <a href="/Truyen/Details/${item.maTruyen}">
                                            ${item.tenTruyen}
                                        </a>
                                    </h3>

                                    <div class="book-footer-row mt-auto">
                                        <div class="book-stats-inline">
                                            <span><i class="fas fa-eye text-primary"></i> ${item.luotXem || 0}</span>
                                        </div>
                                        <a href="/Truyen/Details/${item.maTruyen}" class="btn-read-pill">
                                            Đọc ngay
                                        </a>
                                    </div>
                                </div>
                            </div>`;
                    });
                    $("#recommend-area").html(html);
                }
            });

            // Slide Banner Logic
            const track = document.getElementById('slideTrack');
            const dotsWrap = document.getElementById('slideDots');
            if (track && dotsWrap) {
                const imgs = track.querySelectorAll('img');
                let cur = 0;
                const total = imgs.length;

                if (total > 0) {
                    imgs.forEach((_, i) => {
                        const d = document.createElement('button');
                        d.className = 'slide-dot' + (i === 0 ? ' active' : '');
                        d.addEventListener('click', () => goTo(i));
                        dotsWrap.appendChild(d);
                    });

                    function goTo(n) {
                        cur = (n + total) % total;
                        track.style.transform = `translateX(-${cur * 100}%)`;
                        dotsWrap.querySelectorAll('.slide-dot').forEach((dot, idx) => {
                            dot.classList.toggle('active', idx === cur);
                        });
                    }

                    const prevBtn = document.getElementById('slidePrev');
                    const nextBtn = document.getElementById('slideNext');
                    if (prevBtn) prevBtn.addEventListener('click', () => goTo(cur - 1));
                    if (nextBtn) nextBtn.addEventListener('click', () => goTo(cur + 1));

                    // Tự động chuyển slide sau 5 giây
                    setInterval(() => goTo(cur + 1), 5000);
                }
            }

            // Logic tự động trượt slide Truyện HOT từ phải qua trái (7 truyện/hàng)
            const hotTrack = document.getElementById('hotSliderTrack');
            const hotPrevBtn = document.getElementById('hotPrevBtn');
            const hotNextBtn = document.getElementById('hotNextBtn');

            if (hotTrack) {
                let hotCurrentStep = 0;

                function getVisibleItems() {
                    const width = window.innerWidth;
                    if (width <= 600) return 2;
                    if (width <= 850) return 4;
                    if (width <= 1100) return 5;
                    if (width <= 1400) return 6;
                    return 7;
                }

                function slideHot(direction) {
                    const cards = hotTrack.querySelectorAll('.hot-book-card-item');
                    const totalItems = cards.length;
                    const visibleItems = getVisibleItems();
                    const maxStep = Math.max(0, totalItems - visibleItems);

                    if (maxStep === 0) return;

                    if (direction === 'next') {
                        hotCurrentStep++;
                        if (hotCurrentStep > maxStep) hotCurrentStep = 0;
                    } else {
                        hotCurrentStep--;
                        if (hotCurrentStep < 0) hotCurrentStep = maxStep;
                    }

                    if (cards.length > 0) {
                        const cardWidth = cards[0].offsetWidth;
                        const gap = 14;
                        const offset = hotCurrentStep * (cardWidth + gap);
                        hotTrack.style.transform = `translateX(-${offset}px)`;
                    }
                }

                if (hotNextBtn) hotNextBtn.addEventListener('click', () => slideHot('next'));
                if (hotPrevBtn) hotPrevBtn.addEventListener('click', () => slideHot('prev'));

                // Tự động chuyển slide từ phải qua trái mỗi 3.5 giây
                let hotInterval = setInterval(() => slideHot('next'), 3500);

                // Dừng khi rê chuột vào, tiếp tục khi rời chuột
                hotTrack.parentElement.addEventListener('mouseenter', () => clearInterval(hotInterval));
                hotTrack.parentElement.addEventListener('mouseleave', () => {
                    clearInterval(hotInterval);
                    hotInterval = setInterval(() => slideHot('next'), 3500);
                });

                window.addEventListener('resize', () => {
                    hotCurrentStep = 0;
                    hotTrack.style.transform = 'translateX(0px)';
                });
            }
        });
    </script>
}
