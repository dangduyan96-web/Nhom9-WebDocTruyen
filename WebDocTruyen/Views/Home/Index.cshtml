        <h2 class="section-header-title">Thể loại</h2>
        <a href="@Url.Action("Category", "Home")" class="btn-view-all-pill">
            Xem tất cả thể loại <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="category-cards-grid">
        @{
            string[] cardGradients = { "cat-color-1", "cat-color-2", "cat-color-3", "cat-color-4" };
            int gradIdx = 0;
