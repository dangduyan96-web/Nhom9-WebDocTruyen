@using WebDocTruyen.Models
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject AppDbContext _context

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang Chủ - Web Đọc Truyện Online";
    var user = HttpContextAccessor.HttpContext?.Session.GetString("TaiKhoan");

    // Lấy Top 5 truyện đọc nhiều nhất (Lượt xem thực tế cao nhất trong DB)
    var top5DocNhieu = _context.Truyens
        .OrderByDescending(t => t.LuotXem ?? 0)
        .Take(5)
        .ToList();

    var top1Truyen = top5DocNhieu.FirstOrDefault();
    var topNext4Truyen = top5DocNhieu.Skip(1).Take(4).ToList();

    // Lấy 4 thể loại nổi bật nhất (theo số lượng truyện nhiều nhất trong DB)
    var top4TheLoai = _context.TheLoais
        .OrderByDescending(tl => tl.MaTruyens.Count)
        .ThenBy(tl => tl.TenTheLoai)
        .Take(4)
        .ToList();

    // Lấy danh sách Truyện HOT trong tuần trước (Lượt xem + Lượt thích cao, lấy từ 14 truyện để hiển thị trượt 7 truyện/hàng)
    var dsTruyenHot = _context.Truyens
        .OrderByDescending(t => (t.LuotXem ?? 0) * 0.65 + (t.LuotThich ?? 0) * 0.35)
        .ThenByDescending(t => t.NgayCapNhat ?? t.NgayTao)
        .Take(14)
        .ToList();

    // Lấy danh sách truyện mới cập nhật từ DB (sắp xếp theo NgayCapNhat / NgayTao)
    var truyenMoiCapNhat = _context.Truyens
        .OrderByDescending(t => t.NgayCapNhat ?? t.NgayTao)
        .Take(8)
        .ToList();
}

@model List<WebDocTruyen.Models.Truyen>

