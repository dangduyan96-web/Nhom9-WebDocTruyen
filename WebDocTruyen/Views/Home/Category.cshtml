@using WebDocTruyen.Models
@model List<WebDocTruyen.Models.Truyen>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentCatName = ViewBag.CurrentCategoryName as string ?? "Tất cả truyện";
    var selectedId = ViewBag.SelectedMaTheLoai as int?;
    var allTheLoais = ViewBag.AllTheLoais as List<WebDocTruyen.Models.TheLoai> ?? new List<WebDocTruyen.Models.TheLoai>();
    var quocGiaList = ViewBag.QuocGiaList as List<WebDocTruyen.Models.QuocGiaItem> ?? WebDocTruyen.Models.QuocGiaStore.GetAll();
    var selectedTrangThai = ViewBag.SelectedTrangThai as string;
    var selectedQuocGia = ViewBag.SelectedQuocGia as string;

    // Ghép đầy đủ các tiêu chí đang lọc vào tiêu đề
    var filterParts = new List<string>();
    if (selectedId.HasValue)
    {
        filterParts.Add(currentCatName);
    }
    if (!string.IsNullOrEmpty(selectedTrangThai))
    {
        string tenTrangThai = (selectedTrangThai == "DangPhatHanh" || selectedTrangThai == "DangTienHanh" || selectedTrangThai == "Đang phát hành")
            ? "Đang phát hành"
            : ((selectedTrangThai == "HoanThanh" || selectedTrangThai == "Hoàn thành") ? "Hoàn thành" : selectedTrangThai);
        filterParts.Add(tenTrangThai);
    }
    if (!string.IsNullOrEmpty(selectedQuocGia))
    {
        filterParts.Add(selectedQuocGia);
    }

    string displayHeroTitle = filterParts.Any() ? string.Join(" • ", filterParts) : "Tất cả truyện";
    ViewData["Title"] = "Truyện online: " + displayHeroTitle + " - WebDocTruyen";
}

<style>
    body {
        background-color: #121214 !important;
        color: #e4e4e7;
    }

    .category-page-container {
        max-width: 1440px;
        margin: 20px auto 60px auto;
        padding: 0 15px;
    }

    /* Filter TruyenGG Style */
    .filter-panel-truyengg {
        background: #1e1e24;
        border: 1px solid #2d2d35;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .filter-row-item {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 10px;
    }

    .filter-label-tag {
        font-size: 13px;
        font-weight: 600;
        color: #a1a1aa;
        min-width: 88px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-pill-opt {
        display: inline-block;
        padding: 5px 13px;
        border-radius: 6px;
        background: #272730;
        border: 1px solid #363642;
        color: #d4d4d8;
        font-size: 12.5px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
    }

        .filter-pill-opt:hover {
            color: #ffffff;
            border-color: #ef4444;
            background: #2e2e38;
        }

        .filter-pill-opt.active {
            background: #ef4444;
            border-color: #ef4444;
            color: #ffffff;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
        }

    /* Breadcrumb */
    .cat-breadcrumb {
        font-size: 13.5px;
        margin-bottom: 14px;
        color: #a1a1aa;
    }

        .cat-breadcrumb a {
            color: #ef4444;
            text-decoration: none;
            font-weight: 600;
        }

            .cat-breadcrumb a:hover {
                text-decoration: underline;
            }

    /* Banner Hero Header Category - Thu gọn vừa vặn */
    .cat-hero-card {
        background: linear-gradient(135deg, #1e1e24 0%, #2a1a1e 100%);
        border: 1px solid #36252b;
        border-radius: 14px;
        padding: 20px 26px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    }

    .cat-badge-tag {
        display: inline-flex;
        align-items: center;
        background: #ef4444;
        color: #ffffff;
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 5px;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
    }

    .cat-hero-title {
        font-size: 22px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 4px;
        line-height: 1.3;
    }

    .cat-hero-desc {
        color: #a1a1aa;
        font-size: 13.5px;
        margin-bottom: 0;
    }

    .cat-count-badge {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #f87171;
        padding: 7px 16px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
    }

    @@media (max-width: 768px) {
        .cat-hero-card {
            flex-direction: column;
            align-items: flex-start;
            padding: 16px 18px;
        }

        .cat-hero-title {
            font-size: 19px;
        }
    }

    /* Grid Books - Đồng bộ màu sắc nét */
    .cat-books-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    @@media (max-width: 1200px) {
        .cat-books-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .cat-books-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }
    }

    @@media (max-width: 480px) {
        .cat-books-grid {
            grid-template-columns: 1fr;
        }
    }

    .book-card-premium {
        background: #1e1e24;
        border: 1px solid #2d2d35;
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .book-card-premium:hover {
            transform: translateY(-4px);
            border-color: #ef4444;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
        }

    .book-thumb-wrap {
        position: relative;
        width: 100%;
        padding-top: 135%;
        background: #272730;
        overflow: hidden;
        display: block;
    }

        .book-thumb-wrap img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

    .book-card-premium:hover .book-thumb-wrap img {
        transform: scale(1.05);
    }

    .badge-status-corner {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(16, 185, 129, 0.9);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
        z-index: 2;
    }

    .book-content-wrap {
        padding: 16px 18px 20px 18px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .book-card-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 6px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        min-height: 44px;
    }

        .book-card-title a {
            color: #ffffff;
            text-decoration: none;
            transition: color 0.2s;
        }

            .book-card-title a:hover {
                color: #ef4444;
            }

    .book-card-author {
        font-size: 13px;
        color: #a1a1aa;
        margin-bottom: 12px;
    }

    .book-card-footer {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 12px;
        border-top: 1px solid #2d2d35;
    }

    .book-card-stats {
        font-size: 12.5px;
        color: #8b8b99;
        display: flex;
        gap: 12px;
    }

        .book-card-stats span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

    .btn-read-direct {
        background: #ef4444;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        padding: 5px 14px;
        border-radius: 20px;
        text-decoration: none;
        transition: background 0.2s;
    }

        .btn-read-direct:hover {
            background: #dc2626;
            color: #ffffff;
        }
</style>

<div class="category-page-container">
    <!-- Breadcrumb -->
    <div class="cat-breadcrumb">
        <a href="/">Trang chủ</a> / <span>Truyện đọc online: @displayHeroTitle</span>
    </div>

    <!-- Category Header Card -->
    <div class="cat-hero-card">
        <div>
            <span class="cat-badge-tag"><i class="fas fa-book-reader me-1"></i> Truyện Đọc Online</span>
            <h1 class="cat-hero-title">@displayHeroTitle</h1>
            <p class="cat-hero-desc">
                Danh sách truyện phù hợp với bộ lọc hiện tại tại thư viện WebDocTruyen.
            </p>
        </div>
        <div class="cat-count-badge">
            <i class="fas fa-book"></i> @Model.Count Tác phẩm
        </div>
    </div>

    <!-- Khung lọc truyện: Tình trạng (Đang phát hành, Hoàn thành), Thể loại, Quốc gia (Phong cách nút bấm TruyenGG) -->
    <div class="filter-panel-truyengg">
        <!-- 1. Tình trạng -->
        <div class="filter-row-item">
            <span class="filter-label-tag"><i class="fas fa-toggle-on text-danger"></i> Tình trạng:</span>
            <a href="@Url.Action("Category", "Home", new { maTheLoai = selectedId, quocGia = selectedQuocGia })"
               class="filter-pill-opt @(string.IsNullOrEmpty(selectedTrangThai) ? "active" : "")">
                Tất cả
            </a>
            <a href="@Url.Action("Category", "Home", new { maTheLoai = selectedId, trangThai = "DangPhatHanh", quocGia = selectedQuocGia })"
               class="filter-pill-opt @(selectedTrangThai == "DangPhatHanh" || selectedTrangThai == "Đang phát hành" ? "active" : "")">
                Đang phát hành
            </a>
            <a href="@Url.Action("Category", "Home", new { maTheLoai = selectedId, trangThai = "HoanThanh", quocGia = selectedQuocGia })"
               class="filter-pill-opt @(selectedTrangThai == "HoanThanh" || selectedTrangThai == "Hoàn thành" ? "active" : "")">
                Hoàn thành
            </a>
        </div>

        <!-- 2. Thể loại -->
        <div class="filter-row-item">
            <span class="filter-label-tag"><i class="fas fa-tags text-warning"></i> Thể loại:</span>
            <a href="@Url.Action("Category", "Home", new { trangThai = selectedTrangThai, quocGia = selectedQuocGia })"
               class="filter-pill-opt @(!selectedId.HasValue ? "active" : "")">
                Tất cả
            </a>
            @foreach (var cat in allTheLoais)
            {
                <a href="@Url.Action("Category", "Home", new { maTheLoai = cat.MaTheLoai, trangThai = selectedTrangThai, quocGia = selectedQuocGia })"
                   class="filter-pill-opt @(selectedId == cat.MaTheLoai ? "active" : "")">
                    @cat.TenTheLoai
                </a>
            }
        </div>

        <!-- 3. Quốc gia -->
        <div class="filter-row-item">
            <span class="filter-label-tag"><i class="bi bi-globe-americas text-info"></i> Quốc gia:</span>
            <a href="@Url.Action("Category", "Home", new { maTheLoai = selectedId, trangThai = selectedTrangThai })"
               class="filter-pill-opt @(string.IsNullOrEmpty(selectedQuocGia) ? "active" : "")">
                Tất cả
            </a>
            @foreach (var qg in quocGiaList)
            {
                bool isSelected = !string.IsNullOrEmpty(selectedQuocGia) && selectedQuocGia == qg.TenQuocGia;
                <a href="@Url.Action("Category", "Home", new { maTheLoai = selectedId, trangThai = selectedTrangThai, quocGia = qg.TenQuocGia })"
                   class="filter-pill-opt @(isSelected ? "active" : "")">
                    @qg.TenQuocGia
                </a>
            }
        </div>
    </div>

    <!-- Books List -->
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5" style="background: #1e1e24; border-radius: 16px; border: 1px solid #2d2d35; padding: 50px 20px;">
            <i class="fas fa-book-open text-muted mb-3" style="font-size: 44px; display: block;"></i>
            <h4 class="text-white fw-bold">Chưa có truyện nào khớp với bộ lọc này</h4>
            <p class="text-muted">Vui lòng chọn thể loại, tình trạng hoặc quốc gia khác để khám phá truyện bạn nhé!</p>
            <a href="@Url.Action("Category", "Home")" class="btn btn-danger rounded-pill px-4 py-2 mt-2">
                Xem tất cả truyện
            </a>
        </div>
    }
    else
    {
        <div class="cat-books-grid">
            @foreach (var truyen in Model)
            {
                <div class="book-card-premium">
                    <span class="badge-status-corner">
                        <i class="fas fa-check-circle me-1"></i> @(truyen.TrangThai ?? "Đang tiến hành")
                    </span>

                    <a href="@Url.Action("Details", "Truyen", new { id = truyen.MaTruyen })" class="book-thumb-wrap">
                        <img src="@(string.IsNullOrEmpty(truyen.AnhBia) ? "https://via.placeholder.com/300x420?text=No+Cover" : truyen.AnhBia)"
                             alt="@truyen.TenTruyen"
                             loading="lazy"
                             onerror="this.src='https://via.placeholder.com/300x420?text=No+Cover';" />
                    </a>

                    <div class="book-content-wrap">
                        <h3 class="book-card-title">
                            <a href="@Url.Action("Details", "Truyen", new { id = truyen.MaTruyen })" title="@truyen.TenTruyen">
                                @truyen.TenTruyen
                            </a>
                        </h3>
                        <div class="book-card-author">
                            <i class="fas fa-user-pen me-1 text-danger"></i> @(string.IsNullOrEmpty(truyen.TacGia) ? "Đang cập nhật" : truyen.TacGia)
                        </div>

                        <div class="book-card-footer">
                            <div class="book-card-stats">
                                <span><i class="fas fa-eye text-primary"></i> @(truyen.LuotXem ?? 0)</span>
                                <span><i class="fas fa-heart text-danger"></i> @(truyen.LuotThich ?? 0)</span>
                            </div>
                            <a href="@Url.Action("Details", "Truyen", new { id = truyen.MaTruyen })" class="btn-read-direct">
                                Đọc ngay
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>