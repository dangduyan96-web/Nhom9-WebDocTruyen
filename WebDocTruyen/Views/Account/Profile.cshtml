@model WebDocTruyen.ViewModels.ProfileViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thông tin cá nhân - WebDocTruyen";
}

<style>
    /* Dark Theme Background */
    body {
        background-color: #121214 !important;
        color: #e4e4e7;
    }

    /* Phóng to toàn bộ trang profile (Container rộng rãi 96-98% hoặc max 1520px) */
    .profile-page-container {
        max-width: 1520px;
        width: 95%;
        margin: 35px auto 60px auto;
        padding: 0 10px;
    }

    /* Sidebar Navigation - Phóng to chữ và padding */
    .profile-sidebar {
        background: #1e1e24;
        border-radius: 16px;
        padding: 24px 0;
        border: 1px solid #2d2d35;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }

    .profile-sidebar-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        padding: 0 28px 18px 28px;
        margin-bottom: 12px;
        border-bottom: 1px solid #2d2d35;
        letter-spacing: 0.3px;
    }

    .profile-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .profile-nav-item a {
        display: flex;
        align-items: center;
        padding: 15px 28px;
        color: #a1a1aa;
        text-decoration: none;
        font-size: 15.5px;
        font-weight: 500;
        transition: all 0.2s ease;
        border-left: 4px solid transparent;
    }

    .profile-nav-item a:hover {
        background: #272730;
        color: #ffffff;
    }

    .profile-nav-item.active a {
        background: #272730;
        color: #ef4444;
        font-weight: 700;
        border-left-color: #ef4444;
    }

    .profile-nav-item i {
        width: 26px;
        font-size: 18px;
        margin-right: 12px;
    }

    /* Content Cards - Phóng to khung & bo góc */
    .profile-card {
        background: #1e1e24;
        border-radius: 16px;
        padding: 30px 34px;
        border: 1px solid #2d2d35;
        margin-bottom: 26px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }

    /* Header Profile Info - Avatar & Name lớn hơn */
    .profile-header-user {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
    }

    .user-avatar-wrap {
        position: relative;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid #ef4444;
        flex-shrink: 0;
        background: #272730;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.35);
    }

    .user-avatar-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .user-info-text {
        flex: 1;
        min-width: 250px;
    }

    .user-name-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
    }

    .user-badge-role {
        display: inline-flex;
        align-items: center;
        background: #272730;
        color: #e4e4e7;
        font-size: 13px;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 20px;
        margin-bottom: 14px;
        border: 1px solid #3f3f46;
    }

    .user-badge-role i {
        color: #fbbf24;
        margin-right: 6px;
    }

    .exp-bar-container {
        max-width: 460px;
    }

    .exp-bar-label {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: #8b8b99;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .exp-progress {
        height: 8px;
        background: #2d2d35;
        border-radius: 10px;
        overflow: hidden;
    }

    .exp-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #ef4444, #f87171);
        border-radius: 10px;
    }

    /* Action Dropdown Menu (3 dots) */
    .profile-actions-top {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .dots-menu-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #272730;
        border: 1px solid #3f3f46;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
        font-size: 18px;
    }

    .dots-menu-btn:hover {
        background: #3f3f46;
        color: #ef4444;
    }

    .custom-dropdown-menu {
        background: #1c1c22;
        border: 1px solid #32323c;
        border-radius: 12px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
        min-width: 230px;
        padding: 8px 0;
    }

    .custom-dropdown-menu .dropdown-item {
        color: #d4d4d8;
        padding: 11px 20px;
        font-size: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: 0.2s;
    }

    .custom-dropdown-menu .dropdown-item:hover {
        background: #272730;
        color: #ffffff;
    }

    .custom-dropdown-menu .dropdown-item.text-admin {
        color: #fbbf24;
        font-weight: 600;
    }

    .custom-dropdown-menu .dropdown-item.text-logout {
        color: #ef4444;
        font-weight: 600;
    }

    /* Section Subtitle */
    .section-title-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 19px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 22px;
    }

    .section-title-wrap i {
        color: #ef4444;
        font-size: 20px;
    }

    /* Hồ sơ cá nhân Grid Box - Lớn & Rõ */
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }
    }

    .info-box-item {
        background: #272730;
        border: 1px solid #32323c;
        border-radius: 12px;
        padding: 20px 24px;
    }

    .info-box-label {
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 600;
        color: #8b8b99;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: 0.5px;
    }

    .info-box-value {
        font-size: 17px;
        font-weight: 600;
        color: #f4f4f5;
    }

    .info-gender-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 16px;
        border-radius: 20px;
        font-size: 14.5px;
        font-weight: 600;
    }

    .gender-male {
        background: rgba(59, 130, 246, 0.18);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, 0.35);
    }

    .gender-female {
        background: rgba(236, 72, 153, 0.18);
        color: #f472b6;
        border: 1px solid rgba(236, 72, 153, 0.35);
    }

    /* Thành tích Cards - 3 ô phóng to (Đã bỏ audio, chi phí tiết kiệm, thời gian nghe) */
    .achieve-grid-three {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }

    @@media (max-width: 992px) {
        .achieve-grid-three {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .achieve-grid-three {
            grid-template-columns: 1fr;
        }
    }

    .achieve-card {
        background: #272730;
        border: 1px solid #32323c;
        border-radius: 14px;
        padding: 22px 26px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: transform 0.2s, border-color 0.2s;
    }

    .achieve-card:hover {
        transform: translateY(-2px);
        border-color: #ef4444;
    }

    .achieve-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background: #1e1e24;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #a1a1aa;
        flex-shrink: 0;
    }

    .achieve-title {
        font-size: 14px;
        color: #a1a1aa;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .achieve-value {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
    }

    /* Biểu đồ Xếp hạng */
    .ranking-chart-card {
        background: #272730;
        border: 1px solid #32323c;
        border-radius: 14px;
        padding: 24px 28px;
    }

    .ranking-chart-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 20px;
    }

    .ranking-chart-header i {
        color: #10b981;
        font-size: 18px;
    }

    .ranking-bar-curve {
        height: 64px;
        display: flex;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 18px;
        background: #18181b;
        position: relative;
    }

    .curve-segment {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13.5px;
        font-weight: 700;
        color: #ffffff;
        transition: 0.3s;
    }

    .seg-vua-mot {
        width: 15%;
        background: linear-gradient(135deg, #10b981, #059669);
    }

    .seg-thong-thai {
        width: 25%;
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .seg-mot-sach {
        width: 25%;
        background: linear-gradient(135deg, #ea580c, #c2410c);
    }

    .seg-mot-luoi {
        width: 35%;
        background: linear-gradient(135deg, #e11d48, #be123c);
    }

    .ranking-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 26px;
        font-size: 13.5px;
        color: #a1a1aa;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* Alert Success */
    .profile-alert {
        background: rgba(16, 185, 129, 0.15);
        border: 1px solid #10b981;
        color: #10b981;
        padding: 14px 20px;
        border-radius: 10px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
        font-weight: 500;
    }
</style>

<div class="profile-page-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="profile-alert">
            <i class="fas fa-check-circle fs-5"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="row g-4">
        <!-- 1. CỘT TRÁI: MENU QUẢN LÝ TÀI KHOẢN -->
        <div class="col-lg-3 col-md-4">
            <div class="profile-sidebar">
                <div class="profile-sidebar-title">Quản lý Tài khoản</div>
                <ul class="profile-nav-list">
                    <li class="profile-nav-item active">
                        <a href="@Url.Action("Profile", "Account")">
                            <i class="fas fa-user text-danger"></i> Thông tin cá nhân
                        </a>
                    </li>
                    <li class="profile-nav-item">
                        <a href="/Truyen/LichSuDoc">
                            <i class="fas fa-book-reader"></i> Truyện đã đọc Online (@Model.SoSachDaDoc)
                        </a>
                    </li>
                    <li class="profile-nav-item">
                        <a href="/Truyen/YeuThich">
                            <i class="fas fa-bookmark text-primary"></i> Truyện theo dõi (@Model.SoSachYeuThich)
                        </a>
                    </li>
                    <li class="profile-nav-item">
                        <a href="/Truyen/YeuThich">
                            <i class="fas fa-heart text-danger"></i> Tủ truyện Yêu thích (@Model.SoSachYeuThich)
                        </a>
                    </li>
                    <li class="profile-nav-item">
                        <a href="@Url.Action("BinhLuanCuaToi", "Account")">
                            <i class="fas fa-comments text-info"></i> Bình luận (@Model.SoBinhLuan)
                        </a>
                    </li>
                    <li class="profile-nav-item">
                        <a href="#section-thanh-tich" onclick="document.getElementById('section-thanh-tich').scrollIntoView({behavior: 'smooth'})">
                            <i class="fas fa-trophy text-warning"></i> Thành tích
                        </a>
                    </li>
                    <li class="profile-nav-item">
                        <a href="@Url.Action("LichSuGiaoDich", "Account")">
                            <i class="fas fa-file-invoice-dollar"></i> Lịch sử thanh toán (@Model.SoLichSuThanhToan)
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- 2. CỘT PHẢI: CHI TIẾT HỒ SƠ & THÀNH TÍCH -->
        <div class="col-lg-9 col-md-8">
            <!-- Box 1: Thông tin tóm tắt & EXP + Nút 3 chấm (Đã bỏ nút tròn sáng tối) -->
            <div class="profile-card">
                <div class="profile-header-user">
                    <div class="d-flex align-items-center gap-4">
                        <div class="user-avatar-wrap">
                            <img src="@(string.IsNullOrEmpty(Model.AnhDaiDien) ? "https://cdn-icons-png.flaticon.com/512/847/847969.png" : Model.AnhDaiDien)" 
                                 alt="Avatar" 
                                 onerror="this.src='https://cdn-icons-png.flaticon.com/512/847/847969.png';" />
                        </div>
                        <div class="user-info-text">
                            <h2 class="user-name-title">@Model.HoTen</h2>
                            <div class="user-badge-role">
                                <i class="fas fa-star"></i> @Model.VaiTro
                            </div>
                            <div class="exp-bar-container">
                                <div class="exp-bar-label">
                                    <span>Kinh nghiệm đọc sách</span>
                                    <span>@Model.KinhNghiemDocSach / @Model.MaxKinhNghiem EXP</span>
                                </div>
                                <div class="exp-progress">
                                    <div class="exp-progress-bar" style="width: @((Model.KinhNghiemDocSach * 100) / Model.MaxKinhNghiem)%"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nút Dấu 3 chấm (Đã bỏ nút chuyển đổi sáng/tối) -->
                    <div class="profile-actions-top">
                        <div class="dropdown">
                            <button class="dots-menu-btn" type="button" id="dropdownProfileMenu" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end custom-dropdown-menu" aria-labelledby="dropdownProfileMenu">
                                @if (Model.IsAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item text-admin" href="/Admin/Dashboard">
                                            <i class="fas fa-shield-halved"></i> Trang Quản trị (Admin)
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("EditProfile", "Account")">
                                        <i class="fas fa-user-edit text-info"></i> Chỉnh sửa thông tin
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary" style="margin: 6px 0;"></li>
                                <li>
                                    <a class="dropdown-item text-logout" href="@Url.Action("Logout", "Account")">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Box 2: Hồ sơ cá nhân (Đã bỏ thẻ thư viện, bỏ địa chỉ, thay bằng Giới tính) -->
            <div class="profile-card">
                <div class="section-title-wrap">
                    <i class="fas fa-id-card"></i>
                    <span>Hồ sơ cá nhân</span>
                </div>

                <div class="info-grid">
                    <div class="info-box-item">
                        <div class="info-box-label">
                            <i class="fas fa-envelope"></i> EMAIL ĐĂNG NHẬP
                        </div>
                        <div class="info-box-value text-truncate">@Model.Email</div>
                    </div>

                    <div class="info-box-item">
                        <div class="info-box-label">
                            <i class="fas fa-phone"></i> SỐ ĐIỆN THOẠI
                        </div>
                        <div class="info-box-value">@(string.IsNullOrEmpty(Model.SoDienThoai) ? "0363031626" : Model.SoDienThoai)</div>
                    </div>

                    <div class="info-box-item">
                        <div class="info-box-label">
                            <i class="fas fa-venus-mars"></i> GIỚI TÍNH
                        </div>
                        <div class="info-box-value">
                            @if (Model.GioiTinh == "Nữ")
                            {
                                <span class="info-gender-badge gender-female">
                                    <i class="fas fa-venus"></i> Nữ
                                </span>
                            }
                            else
                            {
                                <span class="info-gender-badge gender-male">
                                    <i class="fas fa-mars"></i> Nam
                                </span>
                            }
                        </div>
                    </div>

                    <div class="info-box-item">
                        <div class="info-box-label">
                            <i class="fas fa-calendar-alt"></i> NGÀY THAM GIA
                        </div>
                        <div class="info-box-value">@Model.NgayThamGia.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>

            <!-- Box 3: Mục Thành tích (Đã loại bỏ audio, chi phí tiết kiệm, thời gian nghe hôm nay) -->
            <div class="profile-card" id="section-thanh-tich">
                <div class="section-title-wrap">
                    <i class="fas fa-trophy text-warning"></i>
                    <span>Thành tích</span>
                </div>
                <div class="text-muted mb-3" style="font-size: 14.5px;">Chung cuộc</div>

                <div class="achieve-grid-three">
                    <!-- 1. Bạn đã đồng hành cùng WebDocTruyen -->
                    <div class="achieve-card">
                        <div class="achieve-icon">
                            <i class="fas fa-medal text-warning"></i>
                        </div>
                        <div>
                            <div class="achieve-title">Bạn đã đồng hành cùng WebDocTruyen</div>
                            <div class="achieve-value">@Model.SoNgayDongHanh <span class="fs-6 fw-normal text-muted">ngày</span></div>
                        </div>
                    </div>

                    <!-- 2. Số truyện đã đọc -->
                    <div class="achieve-card">
                        <div class="achieve-icon">
                            <i class="fas fa-book-open text-info"></i>
                        </div>
                        <div>
                            <div class="achieve-title">Số truyện đã đọc</div>
                            <div class="achieve-value">@Model.SoSachDaDoc</div>
                        </div>
                    </div>

                    <!-- 3. Thời gian đọc hôm nay -->
                    <div class="achieve-card">
                        <div class="achieve-icon">
                            <i class="fas fa-clock text-success"></i>
                        </div>
                        <div>
                            <div class="achieve-title">Thời gian đọc hôm nay</div>
                            <div class="achieve-value">@Model.ThoiGianDocHomNay <span class="fs-6 fw-normal text-muted">phút</span></div>
                        </div>
                    </div>
                </div>

                <!-- Xếp hạng tháng -->
                <div class="ranking-chart-card">
                    <div class="ranking-chart-header">
                        <i class="fas fa-crown"></i>
                        <span>Xếp hạng tháng @DateTime.Now.Month: <strong>@Model.XepHangHienTai</strong></span>
                    </div>

                    <div class="ranking-bar-curve">
                        <div class="curve-segment seg-vua-mot" title="Vua Mọt">0%</div>
                        <div class="curve-segment seg-thong-thai" title="Mọt Thông Thái">13%</div>
                        <div class="curve-segment seg-mot-sach" title="Mọt Sách">12%</div>
                        <div class="curve-segment seg-mot-luoi" title="Mọt Lười">75%</div>
                    </div>

                    <div class="ranking-legend">
                        <div class="legend-item">
                            <span class="legend-dot" style="background: #10b981;"></span>
                            <span>Vua Mọt</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot" style="background: #f59e0b;"></span>
                            <span>Mọt Thông Thái</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot" style="background: #ea580c;"></span>
                            <span>Mọt Sách</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dot" style="background: #e11d48;"></span>
                            <span>Mọt Lười</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
