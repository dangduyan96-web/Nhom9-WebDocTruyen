@model IEnumerable<WebDocTruyen.Models.GoiDoc>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đăng ký gói đọc";
    bool daDangNhap = ViewBag.DaDangNhap == true;
    var goiHienTai = ViewBag.GoiHienTai as WebDocTruyen.Models.NguoiDungGoiDoc;
}

@section styles {
    <style>
        .pkg-card { border: 1.5px solid #e2e8f0; border-radius: 16px; transition: all .2s; height: 100%; }
        .pkg-card:hover { border-color: #e8392a; box-shadow: 0 10px 30px rgba(232,57,42,.12); transform: translateY(-3px); }
        .pkg-price { font-size: 30px; font-weight: 800; color: #e8392a; }
        .pkg-days { background: #fef2f2; color: #e8392a; border-radius: 999px; padding: 3px 12px; font-size: 12px; font-weight: 700; }
    </style>
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Đăng ký gói đọc theo tháng</h2>
        <p class="text-muted mb-0">Đọc không giới hạn các chương trả phí trong thời gian hiệu lực của gói.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]</div>
    }

    @if (goiHienTai != null)
    {
        <div class="alert alert-info">
            <i class="fas fa-crown me-2 text-warning"></i>
            Bạn đang dùng <strong>@goiHienTai.MaGoiDocNavigation.TenGoi</strong>, hết hạn ngày
            <strong>@goiHienTai.NgayKetThuc.ToString("dd/MM/yyyy")</strong>. Đăng ký thêm sẽ được cộng dồn thời hạn.
        </div>
    }

    <div class="row g-4 justify-content-center">
        @if (Model.Any())
        {
            foreach (var g in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card pkg-card p-4 text-center">
                        <h5 class="fw-bold">@g.TenGoi</h5>
                        <div class="my-2"><span class="pkg-days">@g.SoNgayHieuLuc ngày</span></div>
                        <div class="pkg-price my-2">@g.GiaTien.ToString("N0") đ</div>
                        <p class="text-muted small flex-grow-1">@g.MoTa</p>
                        @if (daDangNhap)
                        {
                            <button type="button" class="btn btn-danger rounded-pill fw-bold"
                                    data-bs-toggle="modal" data-bs-target="#modalDangKyGoi"
                                    data-id="@g.MaGoiDoc" data-ten="@g.TenGoi"
                                    data-gia="@g.GiaTien.ToString("N0") đ" data-ngay="@g.SoNgayHieuLuc">
                                Đăng ký ngay
                            </button>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn btn-outline-danger rounded-pill fw-bold">Đăng nhập để đăng ký</a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">Hiện chưa có gói đọc nào đang mở bán.</div>
        }
    </div>
</div>

@if (daDangNhap)
{
    <div class="modal fade" id="modalDangKyGoi" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-crown me-2"></i>Đăng ký gói đọc</h5>
                    <button type="button" class="btn-close btn-close-white" id="btnDong" data-bs-dismiss="modal"></button>
                </div>
                @Html.AntiForgeryToken()

                <!-- Bước 1: chọn phương thức -->
                <div id="buoc1">
                    <div class="modal-body p-4">
                        <div class="p-3 bg-light rounded mb-3">
                            <h6 class="fw-bold mb-1" id="dkGoiTen"></h6>
                            <small class="text-muted">Hiệu lực: <span id="dkGoiNgay"></span> ngày</small>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                            <span class="text-muted">Thành tiền:</span>
                            <span class="fs-4 fw-bold text-danger" id="dkGoiGia"></span>
                        </div>
                        <label class="form-label fw-bold small text-muted text-uppercase">Phương thức thanh toán</label>
                        <div class="list-group">
                            <label class="list-group-item d-flex align-items-center gap-3 py-3">
                                <input class="form-check-input" type="radio" name="phuongThuc" value="VNPAY" checked>
                                <i class="fas fa-qrcode text-danger fa-lg"></i>
                                <span class="fw-bold">Quét mã QR (VNPAY / ngân hàng)</span>
                            </label>
                            <label class="list-group-item d-flex align-items-center gap-3 py-3">
                                <input class="form-check-input" type="radio" name="phuongThuc" value="PayPal">
                                <i class="fab fa-paypal text-primary fa-lg"></i>
                                <span class="fw-bold">PayPal (quét mã QR)</span>
                            </label>
                        </div>
                        <div class="text-danger small mt-2" id="loi"></div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" id="btnTaoQR">
                            <i class="fas fa-qrcode me-1"></i> Tạo mã QR thanh toán
                        </button>
                    </div>
                </div>

                <!-- Bước 2: hiển thị QR -->
                <div id="buoc2" class="d-none">
                    <div class="modal-body p-4 text-center">
                        <div class="fw-bold" id="qrTenGoi"></div>
                        <div class="fs-3 fw-bold text-danger mb-1" id="qrSoTien"></div>
                        <div class="small text-muted mb-2 d-none" id="qrSoTienUSD"></div>
                        <div class="d-inline-block p-3 border rounded-3 bg-white mb-2 position-relative" style="min-width:236px;min-height:236px">
                            <img id="qrImg" class="d-none" style="width:210px;height:210px" alt="QR thanh toán" />
                            <div id="qrBox"></div>
                        </div>
                        <div class="small text-muted" id="qrHuongDan">Mở app ngân hàng / ví và quét mã để thanh toán</div>
                        <div class="small mt-2 d-none" id="thongTinCK">
                            <div>Số TK: <strong id="ckTK"></strong> · <span id="ckTen"></span></div>
                            <div>Nội dung: <strong class="text-danger" id="ckND"></strong></div>
                        </div>
                        <div class="mt-2 d-none" id="payPalDirectBtnWrap">
                            <a id="btnMoPayPal" href="#" target="_blank" class="btn btn-sm btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm">
                                <i class="fab fa-paypal me-1"></i> Mở trang thanh toán PayPal
                            </a>
                        </div>
                        <div class="alert alert-warning small py-2 mt-3 mb-2 d-none" id="demoNote">
                            Chế độ demo: quét mã bằng điện thoại cùng mạng Wi-Fi để mở trang xác nhận thanh toán.
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" id="btnTestXacNhan">
                                <i class="fas fa-check-double me-1"></i> [Giả lập] Xác nhận đã thanh toán
                            </button>
                        </div>
                        <div class="small text-muted mt-2"><i class="fas fa-spinner fa-spin me-1"></i>Đang chờ thanh toán... còn <strong id="demNguoc"></strong></div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" id="btnHuyGD">Hủy giao dịch</button>
                    </div>
                </div>

                <!-- Bước 3: thành công -->
                <div id="buoc3" class="d-none">
                    <div class="modal-body p-4 text-center">
                        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                        <h5 class="fw-bold">Thanh toán thành công!</h5>
                        <p class="text-muted mb-0">Gói đọc của bạn đã được kích hoạt.</p>
                    </div>
                    <div class="modal-footer bg-light">
                        <a href="/DangKyGoi" class="btn btn-danger rounded-pill px-4 fw-bold">Hoàn tất</a>
                    </div>
                </div>

                <!-- Bước 4: thất bại / đã hủy với icon X -->
                <div id="buoc4" class="d-none">
                    <div class="modal-body p-4 text-center">
                        <i class="fas fa-times-circle fa-4x text-danger mb-3"></i>
                        <h5 class="fw-bold text-danger">Thanh toán thất bại!</h5>
                        <p class="text-muted mb-0" id="thatBaiMessage">Giao dịch đã bị hủy hoặc mã QR đã hết hạn.</p>
                    </div>
                    <div class="modal-footer bg-light justify-content-center">
                        <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-bold" id="btnThuLai">
                            <i class="fas fa-redo me-1"></i> Thử lại
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        (function () {
            const modalEl = document.getElementById('modalDangKyGoi');
            if (!modalEl) return;
            const $ = id => document.getElementById(id);
            const token = () => modalEl.querySelector('input[name="__RequestVerificationToken"]').value;
            let goiId = null, maGD = null, poll = null, tick = null;

            function show(step) {
                ['buoc1', 'buoc2', 'buoc3', 'buoc4'].forEach(b => $(b).classList.toggle('d-none', b !== step));
            }
            function dung() { clearInterval(poll); clearInterval(tick); poll = tick = null; }

            $('btnThuLai') && $('btnThuLai').addEventListener('click', function () {
                show('buoc1');
            });

            modalEl.addEventListener('show.bs.modal', function (e) {
                const b = e.relatedTarget;
                goiId = b.dataset.id;
                $('dkGoiTen').textContent = b.dataset.ten;
                $('dkGoiGia').textContent = b.dataset.gia;
                $('dkGoiNgay').textContent = b.dataset.ngay;
                $('loi').textContent = '';
                show('buoc1');
            });
            modalEl.addEventListener('hidden.bs.modal', function () {
                dung();
                if (!$('buoc3').classList.contains('d-none')) location.reload();
            });

            $('btnTaoQR').addEventListener('click', async function () {
                this.disabled = true;
                const body = new URLSearchParams({
                    id: goiId,
                    phuongThuc: modalEl.querySelector('input[name="phuongThuc"]:checked').value
                });
                try {
                    const res = await fetch('/DangKyGoi/TaoThanhToan', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token(), 'Content-Type': 'application/x-www-form-urlencoded' },
                        body
                    });
                    const d = await res.json();
                    if (!res.ok || !d.success) { $('loi').textContent = d.message || 'Không thể tạo giao dịch.'; this.disabled = false; return; }
                    hienQR(d);
                } catch (err) {
                    $('loi').textContent = 'Lỗi kết nối, vui lòng thử lại.';
                }
                this.disabled = false;
            });

            function hienQR(d) {
                maGD = d.maGiaoDich;
                $('qrTenGoi').textContent = d.tenGoi;
                $('qrSoTien').textContent = d.soTienFormatted;
                $('qrBox').innerHTML = '';

                if (d.isPayPal) {
                    $('qrSoTienUSD').textContent = `(~ $${d.soTienUSD} USD)`;
                    $('qrSoTienUSD').classList.remove('d-none');
                    $('qrHuongDan').textContent = 'Dùng điện thoại quét mã QR hoặc bấm nút bên dưới để thanh toán PayPal';
                    $('qrImg').classList.add('d-none');
                    new QRCode($('qrBox'), { text: d.qrText, width: 210, height: 210 });
                    $('thongTinCK').classList.add('d-none');
                    $('demoNote').classList.add('d-none');
                    $('btnMoPayPal').href = d.payPalCheckoutUrl;
                    $('payPalDirectBtnWrap').classList.remove('d-none');
                } else {
                    $('qrSoTienUSD').classList.add('d-none');
                    $('qrHuongDan').textContent = 'Mở app ngân hàng / ví và quét mã để thanh toán';
                    $('payPalDirectBtnWrap').classList.add('d-none');
                    if (d.qrImage) {
                        $('qrImg').src = d.qrImage; $('qrImg').classList.remove('d-none');
                        $('ckTK').textContent = d.taiKhoan; $('ckTen').textContent = d.tenTaiKhoan; $('ckND').textContent = d.noiDung;
                        $('thongTinCK').classList.remove('d-none');
                        $('demoNote').classList.add('d-none');
                    } else {
                        $('qrImg').classList.add('d-none');
                        new QRCode($('qrBox'), { text: d.qrText, width: 210, height: 210 });
                        $('thongTinCK').classList.add('d-none');
                        $('demoNote').classList.remove('d-none');
                    }
                }
                show('buoc2');

                let con = d.hetHanGiay;
                const fmt = s => String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
                $('demNguoc').textContent = fmt(con);
                tick = setInterval(() => {
                    con--; $('demNguoc').textContent = fmt(Math.max(con, 0));
                    if (con <= 0) { 
                        dung(); 
                        $('thatBaiMessage').textContent = 'Mã QR đã hết hạn thanh toán.';
                        show('buoc4'); 
                    }
                }, 1000);

                poll = setInterval(async () => {
                    try {
                        const r = await fetch('/DangKyGoi/TrangThai/' + maGD);
                        if (!r.ok) return;
                        const s = await r.json();
                        if (s.daThanhToan) { dung(); show('buoc3'); }
                        else if (s.hetHan) { 
                            dung(); 
                            $('thatBaiMessage').textContent = 'Giao dịch đã bị hủy hoặc không thành công.';
                            show('buoc4'); 
                        }
                    } catch (e) { }
                }, 3000);
            }

            $('btnHuyGD').addEventListener('click', async function () {
                dung();
                if (maGD) {
                    await fetch('/DangKyGoi/Huy/' + maGD, { method: 'POST', headers: { 'RequestVerificationToken': token() } });
                }
                $('thatBaiMessage').textContent = 'Bạn đã hủy giao dịch thanh toán.';
                show('buoc4');
            });

            $('btnTestXacNhan').addEventListener('click', async function () {
                if (!maGD) return;
                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang xử lý...';
                try {
                    const r = await fetch('/DangKyGoi/KichHoatTest/' + maGD, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token() }
                    });
                    const d = await r.json();
                    if (d.success) {
                        dung();
                        show('buoc3');
                    } else {
                        alert(d.message || 'Lỗi xác nhận');
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-check-double me-1"></i> [Giả lập] Xác nhận đã thanh toán';
                    }
                } catch (e) {
                    alert('Lỗi kết nối');
                    this.disabled = false;
                    this.innerHTML = '<i class="fas fa-check-double me-1"></i> [Giả lập] Xác nhận đã thanh toán';
                }
            });
        })();
    </script>
}
