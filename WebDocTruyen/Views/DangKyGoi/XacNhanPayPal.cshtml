@model WebDocTruyen.Models.LichSuGiaoDich
@{
    Layout = null;
    string? msg = TempData["PayPalMessage"] as string;
    bool isSuccess = TempData["PayPalSuccess"] is bool b && b;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PayPal Checkout - WebDocTruyen</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f5f7fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .paypal-card {
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e1e7ec;
        }
        .paypal-header {
            background: #003087;
            padding: 20px 24px;
            text-align: center;
        }
        .paypal-logo {
            height: 32px;
        }
        .btn-paypal {
            background-color: #ffc439;
            color: #000000;
            font-weight: 700;
            border-radius: 999px;
            padding: 12px 24px;
            border: none;
            transition: all 0.2s;
        }
        .btn-paypal:hover {
            background-color: #f2ba36;
            transform: scale(1.01);
        }
        .order-badge {
            background: #eef2f7;
            border-radius: 8px;
            padding: 14px;
        }
    </style>
</head>
<body>
    <div class="container py-4" style="max-width: 440px;">
        <div class="paypal-card">
            <!-- Header chuẩn nhận diện PayPal -->
            <div class="paypal-header">
                <div class="text-white fw-bold fs-4">
                    <i class="fab fa-paypal text-white me-2"></i><span style="color:#0079C1">Pay</span><span style="color:#00457C">Pal</span>
                </div>
                <div class="text-light small opacity-75 mt-1">Express Checkout</div>
            </div>

            <div class="p-4">
                @if (msg != null)
                {
                    @if (isSuccess)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-circle-check text-success fa-4x mb-3"></i>
                            <h4 class="fw-bold text-dark">Payment Completed!</h4>
                            <p class="text-muted small">@msg</p>
                            <div class="order-badge mt-3 text-start">
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>Transaction ID:</span>
                                    <strong class="text-dark">#GD@(Model.MaGiaoDich.ToString("D5"))</strong>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mt-1">
                                    <span>Package:</span>
                                    <strong class="text-dark">@ViewBag.TenGoi</strong>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mt-1">
                                    <span>Amount Paid:</span>
                                    <strong class="text-success">$@ViewBag.SoTienUSD USD</strong>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-circle-xmark text-danger fa-4x mb-3"></i>
                            <h4 class="fw-bold text-dark">Payment Unsuccessful</h4>
                            <p class="text-muted small">@msg</p>
                        </div>
                    }
                }
                else if (Model.TrangThai == "Chờ thanh toán")
                {
                    <div class="text-center mb-3">
                        <small class="text-muted text-uppercase fw-semibold">Paying to WebDocTruyen Store</small>
                        <h2 class="fw-bold text-dark my-2">$@ViewBag.SoTienUSD <span class="fs-6 text-muted">USD</span></h2>
                        <div class="text-muted small">(Tương đương @Model.SoTien.ToString("N0") VNĐ)</div>
                    </div>

                    <div class="order-badge mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Item:</span>
                            <strong class="text-dark">@ViewBag.TenGoi</strong>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Invoice Number:</span>
                            <span class="text-dark fw-bold">#GD@(Model.MaGiaoDich.ToString("D5"))</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Payment Method:</span>
                            <span class="text-dark"><i class="fab fa-paypal text-primary me-1"></i>PayPal Balance / Card</span>
                        </div>
                    </div>

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@ViewBag.Token" />
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted">Demo PayPal Account:</label>
                            <div class="form-control bg-light small text-muted d-flex align-items-center">
                                <i class="fas fa-user-circle text-primary me-2"></i> buyer-test@paypal.com
                            </div>
                        </div>

                        <button type="submit" class="btn btn-paypal w-100 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="fab fa-paypal fa-lg"></i>
                            <span>Pay Now with PayPal</span>
                        </button>
                    </form>

                    <div class="text-center text-muted mt-3" style="font-size: 11px;">
                        <i class="fas fa-lock me-1 text-success"></i> 256-Bit SSL Encrypted & Secure Checkout
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="alert alert-secondary">
                            Status: <strong>@Model.TrangThai</strong>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
