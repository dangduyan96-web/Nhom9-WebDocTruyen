<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebDocTruyen</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS chung dự án (nếu có) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- NẠP CSS TỪ TRANG CON (Tránh bị trôi giao diện) -->
    @RenderSection("styles", required: false)
</head>
<body>
    <header>
        <!-- Khung Header / Navbar chung có thể đặt ở đây nếu muốn -->
    </header>

    <main role="main">
        <!-- NỘI DUNG TRANG CHỦ HOẶC CÁC TRANG CON SẼ HIỂN THỊ TẠI ĐÂY -->
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-3 mt-4 text-center">
        <div class="container">
            &copy; 2026 - WebDocTruyen
        </div>
    </footer>

    <!-- jQuery & Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- NẠP SCRIPT TỪ TRANG CON -->
    @RenderSection("scripts", required: false)
</body>
</html>